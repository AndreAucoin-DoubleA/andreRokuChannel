{
  "extends": "?./bsconfig.local.json",
  "rootDir": ".",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "tokens/**/*",
    "fonts/**/*"
  ],
  "plugins": ["@rokucommunity/bslint"],
  "lintConfig": "bslint.json",
  "stagingDir": "./build/staging",
  "retainStagingDir": true,
  "createPackage": true,
  "outFile": "./build/LearningRokuDev.zip",
  "sourceMap": true
}
