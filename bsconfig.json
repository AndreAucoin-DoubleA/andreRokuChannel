{
  "extends": "?./bsconfig.local.json",
  "rootDir": ".",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "tokens/**/*",
    "fonts/**/*"
  ],
  "plugins": ["@rokucommunity/bslint"],
  "lintConfig": "bslint.json",
  "sourceMap": true,
  "pruneEmptyCodeFiles": true
}
