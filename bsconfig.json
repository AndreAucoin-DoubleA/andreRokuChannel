{
  "extends": "?./bsconfig.local.json",
  "rootDir": ".",
  "files": [
    "manifest",
    "source/**/*",
    "!source/tests/**/*",
    "components/**/*",
    "images/**/*",
    "tokens/**/*",
    "fonts/**/*"
  ],
  "plugins": [
    "@rokucommunity/bslint"
  ],
  "lintConfig": "bslint.json",
  "sourceMap": true,
  "stagingDir": "./build/staging",
  "retainStagingDir": true
}
