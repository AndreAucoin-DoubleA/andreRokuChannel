<?xml version="1.0" encoding="utf-8"?>
<component name="CustomButton" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/button/CustomButton.brs" />
    <script type="text/brightscript" uri="pkg:/source/theme.brs" />

    <interface>
        <field id="text" type="string" onChange="onTextChanged"/>
        <field id="width" type="float" value="280" onChange="onWidthChanged"/>
        <field id="selected" type="boolean" alwaysNotify="true"/>
    </interface>

    <children>
        <Rectangle id="customButton" width="280" height="70" color="#1b1b3a">
            <Label
                id="label"
                translation="[0,20]"
                width="280"
                horizAlign="center"
                font="font:MediumBoldSystemFont"
                color="#AAAACC"/>
        </Rectangle>
    </children>
    
    
</component>