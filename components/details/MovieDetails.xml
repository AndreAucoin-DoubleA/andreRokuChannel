<?xml version="1.0" encoding="utf-8"?>
<component name="MovieDetails" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/details/MovieDetails.bs"/>

    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="#202226" opacity="0.96"/>

        <Video
            id="videoPlayer"
            width="1920"
            height="1080"
            visible="false"/>

        <Poster
            id="detailsBack"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToZoom"/>

        <Poster
            id="detailsBottomFade"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/details_bottom_fade_overlay.png"/>

        <Animation id="backdropFadeAnim" duration="0.4" easeFunction="inOutQuad">
            <FloatFieldInterpolator
                id="backdropFadeInterp"
                key="[0,1]"
                keyValue="[1,1]"
                fieldToInterp="detailsBack.opacity"/>
        </Animation>

        <Animation id="overlayFadeAnim" duration="0.4" easeFunction="inOutQuad">
            <FloatFieldInterpolator
                id="overlayFadeInterp"
                key="[0,1]"
                keyValue="[1,1]"
                fieldToInterp="detailsBottomFade.opacity"/>
        </Animation>

        <Timer id="bgPlayTimer" duration="5" repeat="false"/>

        <Label
            id="meta"
            translation="[430,550]"
            font="font:MediumSystemFont"
            color="#B7BDC5"/>

        <Label
            id="desc"
            translation="[430,650]"
            width="1100"
            wrap="true"
            font="font:MediumSystemFont"
            color="#DDE0E4"/>

        <CustomButton
            id="playButton"
            text="Play"
            width="260"
            translation="[110, 550]"/>

        <FaveIcon
            id="detailsFav"
            translation="[1740, 550]"/>

        <CustomButton id="nextButton" text="Next in row" width="260"
            translation="[110,640]" visible="false"/>
    </children>
</component>
