<?xml version="1.0" encoding="utf-8"?>
<component name="MovieDetails" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/details/MovieDetails.brs"/>

    <interface>
        <field id="movieContent" type="node" onChange="onMovieContentChanged"/>
        <function name="focusPlayButton"/>
    </interface>

    <children>
        <Rectangle width="1920" height="1080" color="#0f0f23" opacity="0.96"/>

        <Poster
            id="poster"
            width="400"
            height="600"
            translation="[120,180]"
            loadDisplayMode="scaleToZoom"/>

        <Label
            id="title"
            translation="[580,180]"
            width="1100"
            wrap="true"
            font="font:LargeBoldSystemFont"
            color="#FFFFFF"/>

        <Label
            id="meta"
            translation="[580,300]"
            font="font:MediumSystemFont"
            color="#AAAACC"/>

        <Label
            id="desc"
            translation="[580,380]"
            width="1100"
            wrap="true"
            font="font:MediumSystemFont"
            color="#DDDDEE"/>

        <CustomButton
            id="playButton"
            text="Play"
            width="260"
            translation="[580, 710]"/>

        <Video
            id="videoPlayer"
            width="1920"
            height="1080"
            visible="false"/>
    </children>
</component>
