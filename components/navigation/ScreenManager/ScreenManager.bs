import "pkg:/source/navigation/routes.bs"
import "pkg:/source/navigation/screenOps.bs"

sub init()
    m.ctx = screenOps.newContext(m.top)
end sub

function showStack(id as string) as object
    return screenOps.showStack(m.ctx, id, routes.byId)
end function

function focusActive() as boolean
    return screenOps.focusActive(m.ctx)
end function

function suspendActive() as boolean
    return screenOps.suspendActive(m.ctx)
end function

function resumeActive() as boolean
    return screenOps.resumeActive(m.ctx)
end function

sub onStackDepthChanged()
    screenOps.publishDepth(m.ctx)
end sub

function pushOnActive(request as object) as object
    return screenOps.pushOnActive(m.ctx, request)
end function
