import "pkg:/source/navigation/viewStackOps.bs"

function depth() as integer
    return viewStackOps.depth(m.top)
end function

function setRoot(request as object) as object
    return viewStackOps.setRoot(m.top, request)
end function

function push(request as object) as object
    return viewStackOps.push(m.top, request)
end function

function focusTop() as boolean
    return viewStackOps.focusTop(m.top)
end function

function resumeTop() as boolean
    return viewStackOps.resumeTop(m.top)
end function

function suspendTop() as boolean
    return viewStackOps.suspendTop(m.top)
end function

sub onNavRequest(msg as object)
    viewStackOps.handleNavRequest(m.top, msg.GetData())
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    return viewStackOps.handleKey(m.top, key, press)
end function
