<?xml version="1.0" encoding="utf-8"?>
<component name="MoviesPage" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/pages/MoviesPage.bs"/>
    <children>
        <Group id="heroGroup" opacity="0">
            <MaskGroup
                id="itemSelectBackgroundMask"
                translation="[460, 0]"
                maskUri="pkg:/images/backdrop_corner_fade.png"
                maskSize="[1460,680]"
                maskOffset="[0,0]">
                <Poster
                    id="itemSelectBackground"
                    width="1460"
                    height="680"
                    loadDisplayMode="scaleToZoom"/>
            </MaskGroup>

            <Poster
                id="movieLogo"
                translation="[100, 140]"
                width="420"
                height="140"
                loadDisplayMode="scaleToFit"
                visible="false"/>

            <Label
                id="movieTitleLabel"
                translation="[100, 140]"
                width="420"
                height="140"
                font="font:LargeBoldSystemFont"
                color="#FFFFFF"
                vertAlign="top"
                wrap="true"
                visible="false"/>
        </Group>

        <Animation id="heroFadeAnim" duration="0.35" easeFunction="outQuad">
            <FloatFieldInterpolator
                id="heroFadeOpacityInterp"
                key="[0,1]"
                keyValue="[0,1]"
                fieldToInterp="heroGroup.opacity"/>
        </Animation>

        <Timer id="heroDebounce" duration="0.3" repeat="false"/>

        <Timer id="inputGateTimeout" duration="8" repeat="false"/>

        <RowList
            id="rowList"
            showRowLabel="true"
            translation="[40, 530]"
            itemComponentName="MoviePosterItem"
            numRows="3"
            rowFocusAnimationStyle="fixedFocus"
            vertFocusAnimationStyle="fixedFocus"
            drawFocusFeedback="false"
            itemSize="[1880,290]"
            itemSpacing="[0,40]"
            rowItemSize="[[376,220]]"
            rowLabelOffset="[[25,25]]"
            rowItemSpacing="[[30,0]]"/>
        <Label
            id="loadingLabel"
            translation="[40,120]"
            text="Loading movies..."
            font="font:MediumSystemFont"
            color="#B7BDC5"
            visible="false"/>

        <Poster
            id="rightFade"
            translation="[1570,0]"
            width="400"
            height="1080"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/movies_right_fade.png"/>
    </children>
</component>
