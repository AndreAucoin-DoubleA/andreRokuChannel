<?xml version="1.0" encoding="utf-8"?>
<component name="MoviesPage" extends="BasePage">
    <script type="text/brightscript" uri="pkg:/components/pages/MoviesPage.brs"/>
    <interface>
        <field id="selectedMovie" type="node" alwaysNotify="true"/>
    </interface>
    <children>
        <RowList
            id="rowList"
            showRowLabel="true"
            translation="[40, 530]"
            itemComponentName="MoviePosterItem"
            numRows="3"
            rowFocusAnimationStyle="fixedFocus"
            vertFocusAnimationStyle="fixedFocus"
            drawFocusFeedback="false"
            numRenderPasses="2"
            itemSize="[1700,290]"
            itemSpacing="[0,40]"
            rowItemSize="[[376,220]]"
            rowLabelOffset="[[25,25]]"
            rowItemSpacing="[[30,0]]"/>
        <Label
            id="loadingLabel"
            translation="[60,120]"
            text="Loading movies..."
            font="font:MediumSystemFont"
            color="#AAAACC"
            visible="false"/>
    </children>
</component>
