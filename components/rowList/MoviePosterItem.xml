<?xml version="1.0" encoding="utf-8"?>
<component name="MoviePosterItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/rowList/MoviePosterItem.bs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged"/>
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged"/>
        <field id="rowHasFocus" type="boolean" onChange="onFocusChanged"/>
    </interface>

    <children>
        <Poster
            id="focusRing"
            translation="[0,0]"
            width="376"
            height="220"
            uri="pkg:/images/item_focus_ring.png"
            blendColor="#8B5CD6"
            visible="false"/>
        <MaskGroup
            id="posterMask"
            translation="[10,10]"
            maskUri="pkg:/images/poster_mask_landscape.png"
            maskSize="[356,200]"
            maskOffset="[0,0]">
            <Poster
                id="poster"
                width="356"
                height="200"
                loadDisplayMode="scaleToZoom"
                loadWidth="356"
                loadHeight="200"
                loadingBitmapUri="pkg:/images/poster_placeholder_landscape.png"
                failedBitmapUri="pkg:/images/poster_placeholder_landscape.png"/>
        </MaskGroup>
    </children>
</component>
