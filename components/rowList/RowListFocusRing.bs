import "pkg:/source/theme.bs"

sub init()
    m.rowList = invalid

    m.top.uri = "pkg:/images/item_focus_ring.png"
    m.top.visible = false

    t = theme.Theme()
    m.top.blendColor = t.color("component.moviePoster.focusRingColor", "0x8B5CD6FF")
end sub

sub onRowListChanged()
    detach()

    m.rowList = m.top.rowList
    if m.rowList = invalid then return

    m.rowList.observeField("focusedChild", "refresh")
    m.rowList.observeField("visible", "refresh")
    m.rowList.observeField("content", "refresh")
    m.rowList.observeField("rowItemSize", "refresh")
    m.rowList.observeField("translation", "refresh")

    refresh()
end sub

sub detach()
    if m.rowList = invalid then return

    m.rowList.unobserveField("focusedChild")
    m.rowList.unobserveField("visible")
    m.rowList.unobserveField("content")
    m.rowList.unobserveField("rowItemSize")
    m.rowList.unobserveField("translation")

    m.rowList = invalid
end sub

sub refresh()
    if m.rowList = invalid then return

    reposition()
    updateVisibility()
end sub

sub reposition()
    sizes = m.rowList.rowItemSize
    if sizes.Count() = 0 then return

    itemW = sizes[0][0]
    itemH = sizes[0][1]
    rowH = m.rowList.itemSize[1]
    origin = m.rowList.translation

    m.top.width = itemW
    m.top.height = itemH
    m.top.translation = [origin[0], origin[1] + (rowH - itemH) - m.top.offsetY]
end sub

sub updateVisibility()
    content = m.rowList.content
    hasRows = (content <> invalid and content.getChildCount() > 0)
    m.top.visible = m.rowList.isInFocusChain() and m.rowList.visible and hasRows
end sub
