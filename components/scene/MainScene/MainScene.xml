<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <customization suspendhandler="customSuspend" />
    <customization resumehandler="customResume" />

    <script type="text/brightscript" uri="pkg:/components/scene/MainScene/MainScene.bs"/>

    <interface>
        <field id="deepLink" type="assocarray" alwaysNotify="true"/>
        <function name="signalLaunchComplete"/>
    </interface>

    <children>
        <ScreenManager id="screens"/>

        <Timer id="launchTimeout" duration="8" repeat="false"/>

        <Group id="chrome">
            <Rectangle
                id="navFade"
                translation="[0,0]"
                width="290"
                height="1080"
                opacity="1"
                color="0x101018FF"/>

            <SiteNav id="sideBar" translation="[40,100]"/>

            <Poster
                id="bottomFade"
                translation="[0,880]"
                width="1920"
                height="200"
                loadDisplayMode="scaleToFill"
                uri="pkg:/assets/images/bottom_fade.png"/>
        </Group>

        <LoadingIndicator
            id="deepLinkLoader"
            translation="[910,490]"
            message="Opening..."
            errorMessage="We couldn't open that link."/>

        <LoadingIndicator
            id="launchError"
            translation="[910,490]"
            timeout="0"
            errorMessage="Couldn't load content"/>
    </children>
</component>
