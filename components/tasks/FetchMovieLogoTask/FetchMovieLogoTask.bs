import "pkg:/source/roku_modules/promises/promises.brs"
import "pkg:/source/api/http.bs"
import "pkg:/source/api/tmdb.bs"
import "pkg:/source/utils/strings.bs"

sub init()
    m.top.functionName = "fetchLogo"
end sub

sub fetchLogo()
    movieId = m.top.movieId

    if movieId = ""
        promises.resolve("", m.top.promise)
        return
    end if

    json = http.getJson(tmdb.movieImagesUrl(movieId))

    if json = invalid
        promises.reject(`logo request failed for ${movieId}`, m.top.promise)
        return
    end if

    promises.resolve(logoUrlFrom(json), m.top.promise)
end sub

function logoUrlFrom(json as object) as string
    if json.logos = invalid or json.logos.Count() = 0 then return ""

    return tmdb.imageUrl(tmdb.LOGO, strings.fromValue(preferredLogo(json.logos).file_path))
end function

function preferredLogo(logos as object) as object
    for each logo in logos
        if logo.iso_639_1 = "en" then return logo
    end for

    return logos[0]
end function
