import "pkg:/source/data/movieFetch.bs"
import "pkg:/components/tasks/FetchMovieTask/FetchMovieTask.interface.bs"

sub init()
    m.top.functionName = "fetchMovie"
end sub

sub fetchMovie()
    result = movieFetch.forId(m.top.movieId)

    if result.movie <> invalid then m.top.movie = result.movie
    m.top.status = result.status
end sub
