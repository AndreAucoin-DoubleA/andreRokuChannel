import "pkg:/source/api/http.bs"
import "pkg:/source/api/tmdb.bs"
import "pkg:/source/data/movieContent.bs"
import "pkg:/source/utils/logger.bs"
import "pkg:/source/roku_modules/promises/promises.brs"

sub init()
    m.top.functionName = "fetchMovie"
end sub

sub fetchMovie()
    movieId = m.top.movieId

    if movieId = ""
        promises.reject("missing movie id", m.top.promise)
        return
    end if

    json = http.getJson(tmdb.movieUrl(movieId))

    if json = invalid or json.id = invalid
        logger.warn("FetchMovieTask", `no movie for id ${movieId}`)
        promises.reject(`no movie for id ${movieId}`, m.top.promise)
        return
    end if

    promises.resolve(movieContent.fromJson(json), m.top.promise)
end sub
