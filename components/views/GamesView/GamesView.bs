import "pkg:/source/theme/theme.bs"
import "pkg:/source/services/favorites.bs"

sub init()
    m.titleLabel = m.top.findNode("titleLabel")
    m.gamesList = m.top.findNode("gamesList")
    m.movieRows = m.top.findNode("movieRows")
    m.loader = m.top.findNode("loader")
    m.loader.observeField("errorDismissed", "onLoadErrorDismissed")

    m.rootContent = CreateObject("roSGNode", "ContentNode")
    m.movieRows.content = m.rootContent
    m.movieRows.visible = false

    m.signature = ""
    m.catalogIndex = invalid
    m.indexedVersion = -1
    m.cachedIds = invalid
    m.cachedIdsVersion = -1

    m.movieRows.observeField("selectedMovie", "onFavoriteSelected")
    m.global.observeField("catalogVersion", "refreshFavorites")
    m.global.observeField("favoritesVersion", "refreshFavorites")
    m.global.observeField("catalogReady", "onCatalogReady")

    applyTheme()
end sub

sub applyTheme()
    t = theme.current()

    m.titleLabel.color = t.color("component.page.titleColor", "0xFFFFFFFF")
    m.titleLabel.font = t.font("component.page.titleTypography", "font:LargeBoldSystemFont")

    bodyColor = t.color("component.page.bodyColor", "0xB7BDC5FF")
    bodyFont = t.font("component.page.bodyTypography", "font:MediumSystemFont")

    for i = 0 to m.gamesList.getChildCount() - 1
        row = m.gamesList.getChild(i)
        row.color = bodyColor
        row.font = bodyFont
    end for
end sub

sub viewWillAppear()
    refreshFavorites()
end sub

sub refreshFavorites()
    updateLoader()

    index = catalogIndex()
    movies = favoriteMovies(index)

    signature = favoritesSignature(movies)
    if signature = m.signature then return
    m.signature = signature

    root = CreateObject("roSGNode", "ContentNode")

    if movies.Count() > 0
        row = root.createChild("ContentNode")
        row.title = "My Favorites"
        row.AppendChildren(movies)
    end if

    m.rootContent = root
    m.movieRows.content = root
    m.movieRows.visible = (movies.Count() > 0)

    if movies.Count() > 0 then claimFocusForRow()
end sub

sub updateLoader()
    if m.global.catalog.getChildCount() > 0
        m.loader.callFunc("hide")
        return
    end if

    if m.global.catalogReady
        m.loader.callFunc("showError", "Couldn't load content")
        return
    end if

    m.loader.callFunc("show")
end sub

sub onLoadErrorDismissed()
    popView()
end sub

sub onCatalogReady()
    refreshFavorites()
end sub

sub viewWillHide()
    m.loader.callFunc("hide")
end sub

sub claimFocusForRow()
    if not m.top.isInFocusChain() then return
    if m.movieRows.isInFocusChain() then return

    m.movieRows.callFunc("focusRows")
end sub

function favoriteMovies(index as object) as object
    movies = []

    for each movieId in cachedFavoriteIds()
        node = index[movieId]
        if node <> invalid then movies.Push(node.clone(false))
    end for

    return movies
end function

function cachedFavoriteIds() as object
    if m.cachedIds <> invalid and m.cachedIdsVersion = m.global.favoritesVersion
        return m.cachedIds
    end if

    m.cachedIds = favorites.favoriteIds()
    m.cachedIdsVersion = m.global.favoritesVersion

    return m.cachedIds
end function

function catalogIndex() as object
    if m.catalogIndex <> invalid and m.indexedVersion = m.global.catalogVersion
        return m.catalogIndex
    end if

    index = {}

    for each row in m.global.catalog.getChildren(-1, 0)
        for each movie in row.getChildren(-1, 0)
            id = movie.movieId
            if id <> invalid and id <> "" and index[id] = invalid then index[id] = movie
        end for
    end for

    m.catalogIndex = index
    m.indexedVersion = m.global.catalogVersion

    return index
end function

function favoritesSignature(movies as object) as string
    ids = []

    for each movie in movies
        ids.Push(movie.movieId)
    end for

    return ids.Join(",")
end function

sub onFavoriteSelected()
    pushMovieDetails(m.movieRows)
end sub

function setViewFocus() as boolean
    if m.rootContent.getChildCount() = 0 then return m.top.setFocus(true)

    return m.movieRows.callFunc("focusRows")
end function
