<?xml version="1.0" encoding="utf-8"?>
<component name="GamesView" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/views/GamesView/GamesView.bs"/>

    <interface>
        <!-- Exposed for tests. -->
        <function name="applyTheme"/>

        <!-- Exposed for tests: favorites row assembly and the loader. -->
        <function name="refreshFavorites"/>
        <function name="updateLoader"/>
        <function name="favoriteMovies"/>
        <function name="cachedFavoriteIds"/>
        <function name="catalogIndex"/>
        <function name="favoritesSignature"/>
    </interface>
    <children>
        <Label
            id="titleLabel"
            translation="[200,80]"
            text="Games"/>
        <LayoutGroup
            id="gamesList"
            translation="[200, 160]"
            layoutDirection="vert"
            itemSpacings="[15]">
            <Label id="game1Label" text="1. Mario Kart World Tour"/>
        </LayoutGroup>

        <MovieRowList
            id="movieRows"
            translation="[200, 530]"
            rowSpacing="40"/>

        <LoadingIndicator
            id="loader"
            translation="[910,490]"
            message="Loading..."
            errorMessage="Couldn't load content"/>
    </children>
</component>
