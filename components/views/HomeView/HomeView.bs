import "pkg:/source/theme/theme.bs"
import "pkg:/source/services/favorites.bs"
import "pkg:/source/services/a11y.bs"

sub init()
    m.titleLabel = m.top.findNode("titleLabel")
    m.bodyLabel = m.top.findNode("bodyLabel")
    m.rowList = m.top.findNode("rowList")
    m.loader = m.top.findNode("loader")

    m.rootContent = CreateObject("roSGNode", "ContentNode")
    m.rowList.content = m.rootContent
    m.rowList.visible = false

    m.signature = ""
    m.catalogIndex = invalid
    m.indexedVersion = -1
    m.cachedIds = invalid
    m.cachedIdsVersion = -1

    m.launchReported = false
    m.lastAnnouncedRow = -1

    m.rowList.observeField("rowItemSelected", "onFavoriteSelected")
    m.rowList.observeField("rowItemFocused", "onFavoriteFocused")
    m.global.observeField("catalogVersion", "refreshFavorites")
    m.global.observeField("favoritesVersion", "refreshFavorites")
    m.global.observeField("catalogReady", "onCatalogReady")

    applyTheme()

    m.decor = m.top.findNode("decor")
    m.decor.rowList = m.rowList
end sub

sub applyTheme()
    t = theme.Theme()

    m.titleLabel.color = t.color("component.page.titleColor", "0xFFFFFFFF")
    m.titleLabel.font = t.font("component.page.titleTypography", "font:LargeBoldSystemFont")

    m.bodyLabel.color = t.color("component.page.bodyColor", "0xB7BDC5FF")
    m.bodyLabel.font = t.font("component.page.bodyTypography", "font:MediumSystemFont")

    m.rowList.rowItemSize = [[t.size("component.moviePoster.width", 376), t.size("component.moviePoster.height", 220)]]

    m.rowList.rowLabelColor = t.color("component.rowList.rowLabelColor", "0x8E949DFF")
    m.rowList.rowLabelFont = t.font("component.rowList.rowLabelTypography", "font:SmallSystemFont")
end sub

sub viewWillAppear()
    refreshFavorites()
end sub

sub refreshFavorites()
    updateLoader()

    index = catalogIndex()
    movies = favoriteMovies(index)

    reportLaunchContentReady(movies)

    signature = favoritesSignature(movies)
    if signature = m.signature then return
    m.signature = signature

    root = CreateObject("roSGNode", "ContentNode")

    if movies.Count() > 0
        row = root.createChild("ContentNode")
        row.title = "My Favorites"
        row.AppendChildren(movies)
    end if

    print "[HomePage] TEMP rebuild rows=" ; root.getChildCount() ; " order=" ; signature

    m.rootContent = root
    m.rowList.content = root
    m.rowList.visible = (movies.Count() > 0)

    if movies.Count() > 0
        m.lastAnnouncedRow = -1
        claimFocusForRow()
        announceFocus()
    end if
end sub

sub updateLoader()
    if m.global.catalog.getChildCount() > 0
        m.loader.callFunc("hide")
        return
    end if

    if m.global.catalogReady
        m.loader.callFunc("showError", "Couldn't load content")
        return
    end if

    m.loader.callFunc("show")
end sub

sub onCatalogReady()
    refreshFavorites()
end sub

sub viewWillHide()
    m.loader.callFunc("hide")
end sub

sub claimFocusForRow()
    if not m.top.isInFocusChain() then return
    if m.rowList.isInFocusChain() then return

    m.rowList.setFocus(true)
end sub

function favoriteMovies(index as object) as object
    movies = []

    for each movieId in cachedFavoriteIds()
        node = index[movieId]
        if node <> invalid then movies.Push(node.clone(false))
    end for

    return movies
end function

function cachedFavoriteIds() as object
    if m.cachedIds <> invalid and m.cachedIdsVersion = m.global.favoritesVersion
        return m.cachedIds
    end if

    m.cachedIds = favorites.favoriteIds()
    m.cachedIdsVersion = m.global.favoritesVersion

    return m.cachedIds
end function

function catalogIndex() as object
    if m.catalogIndex <> invalid and m.indexedVersion = m.global.catalogVersion
        return m.catalogIndex
    end if

    index = {}

    for each row in m.global.catalog.getChildren(-1, 0)
        for each movie in row.getChildren(-1, 0)
            id = movie.movieId
            if id <> invalid and id <> "" and index[id] = invalid then index[id] = movie
        end for
    end for

    m.catalogIndex = index
    m.indexedVersion = m.global.catalogVersion

    return index
end function

function favoritesSignature(movies as object) as string
    ids = []

    for each movie in movies
        ids.Push(movie.movieId)
    end for

    return ids.Join(",")
end function

sub onFavoriteFocused()
    sel = m.rowList.rowItemFocused
    if sel = invalid or sel.Count() < 2 then return

    row = m.rootContent.getChild(sel[0])
    if row = invalid then return

    movie = row.getChild(sel[1])
    if movie = invalid then return

    m.decor.summaryText = movie.title

    announceFocus()
end sub

sub announceFocus()
    if not m.rowList.isInFocusChain() then return

    sel = m.rowList.rowItemFocused
    if sel = invalid or sel.Count() < 2 then return

    newRow = (sel[0] <> m.lastAnnouncedRow)
    m.lastAnnouncedRow = sel[0]

    a11y.announceRowItem(m.rowList, m.rootContent, newRow)
end sub

sub onFavoriteSelected()
    sel = m.rowList.rowItemSelected

    row = m.rootContent.getChild(sel[0])
    if row = invalid then return

    movie = row.getChild(sel[1])
    if movie = invalid then return

    pushView("MovieDetailsView", { movie: movie, row: row, index: sel[1] })
end sub

function setViewFocus() as boolean
    if m.rootContent.getChildCount() = 0 then return m.top.setFocus(true)

    result = m.rowList.setFocus(true)
    m.lastAnnouncedRow = -1
    announceFocus()

    return result
end function

sub reportLaunchContentReady(movies as object)
    if m.launchReported then return

    if m.global.catalog.getChildCount() = 0 and not m.global.catalogReady then return

    print "[HomePage] readyCheck: favIds=" ; cachedFavoriteIds().Count() ; " resolved=" ; movies.Count() ; " catalogVersion=" ; m.global.catalogVersion
    if cachedFavoriteIds().Count() > 0 and movies.Count() = 0 then return

    m.launchReported = true
    m.top.getScene().callFunc("signalLaunchComplete")
end sub
