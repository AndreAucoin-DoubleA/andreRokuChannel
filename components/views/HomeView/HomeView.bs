const LOGO_MARGIN_RIGHT = 400
const LOGO_GAP_ABOVE_ROWS = 10

sub init()
    m.enlargeRows = m.top.findNode("enlargeRows")
    m.logo = m.top.findNode("shubi_poster")

    m.launchReported = false

    m.global.observeField("contentWidth", "onContentWidthChanged")
    m.global.observeField("catalogVersion", "reportLaunchContentReady")
    m.global.observeField("catalogReady", "reportLaunchContentReady")
    m.enlargeRows.observeField("translation", "onRowsMoved")

    positionLogo()
end sub

sub onRowsMoved()
    positionLogo()
end sub

sub onContentWidthChanged()
    positionLogo()
end sub


sub positionLogo()
    rowsPos = m.enlargeRows.translation
    if rowsPos = invalid then return

    m.logo.translation = [rowsPos[0] + m.enlargeRows.rowWidth - m.logo.width, rowsPos[1] - m.logo.height - LOGO_GAP_ABOVE_ROWS]
end sub

sub viewWillAppear()
    reportLaunchContentReady()
end sub

function setViewFocus() as boolean
    return m.enlargeRows.callFunc("focusRows")
end function

sub reportLaunchContentReady()
    if m.launchReported then return

    if m.global.catalog.getChildCount() = 0 and not m.global.catalogReady then return

    m.launchReported = true
    m.top.getScene().callFunc("signalLaunchComplete")
end sub
