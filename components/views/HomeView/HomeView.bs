sub init()
    m.enlargeRows = m.top.findNode("enlargeRows")

    m.launchReported = false

    m.global.observeField("catalogVersion", "reportLaunchContentReady")
    m.global.observeField("catalogReady", "reportLaunchContentReady")
end sub

sub viewWillAppear()
    reportLaunchContentReady()
end sub

function setViewFocus() as boolean
    return m.enlargeRows.callFunc("focusRows")
end function

sub reportLaunchContentReady()
    if m.launchReported then return

    if m.global.catalog.getChildCount() = 0 and not m.global.catalogReady then return

    m.launchReported = true
    m.top.getScene().callFunc("signalLaunchComplete")
end sub
