import "pkg:/source/theme/theme.bs"
import "pkg:/source/services/favorites.bs"
import "pkg:/source/services/bookmarks.bs"
import "pkg:/source/services/a11y.bs"
import "pkg:/source/navigation/nav.interface.bs"
import "pkg:/source/utils/logger.bs"
import "pkg:/source/data/trickplay.bs"
import "pkg:/components/tasks/FetchMovieTask/FetchMovieTask.interface.bs"
import "pkg:/components/views/MovieDetailsView/MovieDetailsView.interface.bs"

const LOGO_INSET = 80
const DESC_RIGHT_EDGE = 1530
const DESC_MAX_LINES = 3

sub init()
    m.top.translation = [-m.global.contentOffsetX, 0]
    m.meta = m.top.findNode("meta")
    m.desc = m.top.findNode("desc")
    m.cast = m.top.findNode("cast")
    m.scrim = m.top.findNode("scrim")
    m.detailsBack = m.top.findNode("detailsBack")
    m.detailsBottomFade = m.top.findNode("detailsBottomFade")

    m.button = m.top.findNode("playButton")
    m.button.observeField("selected", "onButtonPressed")

    m.nextButton = m.top.findNode("nextButton")
    m.nextButton.observeField("selected", "onNextPressed")

    m.restartButton = m.top.findNode("restartButton")
    m.restartButton.observeField("selected", "onRestartPress")

    m.favButton = m.top.findNode("detailsFav")
    m.favButton.observeField("favorited", "onFavoriteToggled")

    m.backdropFadeAnim = m.top.findNode("backdropFadeAnim")
    m.backdropFadeInterp = m.top.findNode("backdropFadeInterp")
    m.overlayFadeAnim = m.top.findNode("overlayFadeAnim")
    m.overlayFadeInterp = m.top.findNode("overlayFadeInterp")

    m.bgTimer = m.top.findNode("bgPlayTimer")
    m.bgTimer.observeField("fire", "onBgTimerFire")

    m.video = m.top.findNode("videoPlayer")
    m.video.observeField("state", "onVideoStateChanged")

    m.video.observeField("overlayButtonSelected", "onOverlayButtonSelected")

    m.videoLoad = m.top.findNode("videoLoad")

    m.bgActive = false
    m.fullscreenActive = false
    m.bgPlayed = false
    m.trailerFailed = false
    m.params = {}
    m.currentMovieId = ""
    m.backdropUri = ""
    m.returnFocus = invalid
    m.errorDialog = invalid
    m.autoPlay = false
    m.detailsTask = invalid

    layoutContent()
    applyTheme()
end sub

sub layoutContent()
    m.leftEdge = m.global.contentOffsetX + LOGO_INSET

    m.meta.translation = [m.leftEdge, 450]

    m.desc.translation = [m.leftEdge, 520]
    m.desc.width = DESC_RIGHT_EDGE - m.leftEdge
    m.desc.maxLines = DESC_MAX_LINES

    m.cast.translation = [m.leftEdge, 640]
    m.cast.width = DESC_RIGHT_EDGE - m.leftEdge
    m.cast.maxLines = 1

    m.button.translation = [m.leftEdge, 700]
    m.restartButton.translation = [m.leftEdge, 790]
end sub

sub renderButtons()
    canResume = bookmarks.positionFor(m.currentMovieId) > 0

    if canResume
        m.button.text = "Resume"
    else
        m.button.text = "Play"
    end if

    m.restartButton.visible = canResume

    m.nextButton.translation = [m.leftEdge, 790]
    if canResume then m.nextButton.translation = [m.leftEdge, 880]
end sub

sub showDetailsChrome(show as boolean)
    m.meta.visible = show
    m.desc.visible = show
    m.cast.visible = show
    m.button.visible = show
    m.favButton.visible = show

    if show
        m.nextButton.visible = (nextSibling() <> invalid)
        renderButtons()
    else
        m.nextButton.visible = false
        m.restartButton.visible = false
    end if
end sub

sub onRestartPress()
    bookmarks.clear(m.currentMovieId)
    onButtonPressed()
end sub

sub applyTheme()
    t = theme.current()

    m.scrim.color = t.color("component.movieDetails.scrimColor", "0x202226FF")
    m.scrim.opacity = t.number("component.movieDetails.scrimOpacity", 0.96)

    m.detailsBottomFade.blendColor = t.color("component.movieDetails.bottomFadeBlendColor", "0xFFFF6DFF")

    m.meta.color = t.color("component.movieDetails.metaColor", "0xB7BDC5FF")
    m.meta.font = t.font("component.movieDetails.metaTypography", "font:MediumSystemFont")

    m.desc.color = t.color("component.movieDetails.descriptionColor", "0xDDE0E4FF")
    m.desc.font = t.font("component.movieDetails.descriptionTypography", "font:MediumSystemFont")

    m.cast.color = t.color("component.movieDetails.castColor", "0xB7BDC5FF")
    m.cast.font = t.font("component.movieDetails.castTypography", "font:MediumSystemFont")
end sub

sub viewDidLoad(params as movieDetails.Params)
    m.params = params
    m.autoPlay = (params.autoPlay = true)
    applyMovie(params.movie)
    m.nextButton.visible = (nextSibling() <> invalid)
    announceScreen()
end sub
sub viewWillAppear()
    beginAmbientCountdown()

    if m.autoPlay
        m.autoPlay = false
        onButtonPressed()
    end if
end sub

sub viewWillHide()
    resetPlayback()
    closePlaybackError()
end sub

sub viewWillDisappear()
    resetPlayback()
    closePlaybackError()
    cancelDetailsFetch()
end sub

function setViewFocus() as boolean
    if m.fullscreenActive then return m.video.setFocus(true)
    return m.button.setFocus(true)
end function

sub applyMovie(movie as object)
    if movie = invalid then return

    m.meta.text = titleWithMeta(movie)
    m.desc.text = movie.description
    m.cast.text = castLine(movie)

    m.backdropUri = ""
    if movie.HDBackgroundImageUrl <> invalid then m.backdropUri = movie.HDBackgroundImageUrl

    m.detailsBack.uri = m.backdropUri

    m.currentMovieId = movie.movieId
    if m.currentMovieId = invalid then m.currentMovieId = ""

    m.favButton.favorited = favorites.isFavorite(m.currentMovieId)

    requestFullDetails(movie)
end sub

function releaseYear(releaseDate as dynamic) as string
    if releaseDate = invalid then return ""
    if Len(releaseDate) < 4 then return ""

    return Left(releaseDate, 4)
end function

function runtimeText(minutes as dynamic) as string
    if minutes = invalid then return ""
    if minutes <= 0 then return ""

    hours = Int(minutes / 60)
    mins = minutes MOD 60

    if hours = 0 then return mins.ToStr() + "m"
    if mins = 0 then return hours.ToStr() + "h"

    return hours.ToStr() + "h " + mins.ToStr() + "m"
end function

function castLine(movie as object) as string
    if movie.cast = invalid then return ""
    if movie.cast = "" then return ""

    return "Starring: " + movie.cast
end function

function titleWithMeta(movie as object) as string
    parts = []

    year = releaseYear(movie.releaseDate)
    if year <> "" then parts.Push(year)

    cert = ""
    if movie.certification <> invalid then cert = movie.certification
    if cert <> "" then parts.Push(cert)

    runtime = runtimeText(movie.runtimeMinutes)
    if runtime <> "" then parts.Push(runtime)

    if parts.Count() = 0 then return movie.title

    return movie.title + "  -  " + parts.Join("  -  ")
end function

sub requestFullDetails(movie as object)
    if m.currentMovieId = "" then return

    if movie.runtimeMinutes <> invalid
        if movie.runtimeMinutes > 0 then return
    end if

    cancelDetailsFetch()

    task = CreateObject("roSGNode", "FetchMovieTask")
    task.movieId = m.currentMovieId
    task.observeField("status", "onFullDetailsResolved")
    m.detailsTask = task
    task.control = "RUN"
end sub

sub cancelDetailsFetch()
    if m.detailsTask = invalid then return

    m.detailsTask.unobserveField("status")
    m.detailsTask.control = "stop"
    m.detailsTask = invalid
end sub

sub onFullDetailsResolved(msg as object)
    task = msg.GetRoSGNode()
    status = msg.GetData()

    m.detailsTask = invalid

    if status <> tasks.Status.ok then return
    if task.movie = invalid then return
    if task.movie.movieId <> m.currentMovieId then return

    m.meta.text = titleWithMeta(task.movie)
    m.cast.text = castLine(task.movie)
    announceScreen()
end sub

sub onFavoriteToggled()
    if m.currentMovieId = "" then return

    favorited = m.favButton.favorited

    if favorited = favorites.isFavorite(m.currentMovieId) then return

    favorites.setFavorite(m.currentMovieId, favorited)
end sub

function nextSibling() as object
    if m.params.row = invalid or m.params.index = invalid then return invalid
    return m.params.row.getChild(m.params.index + 1)
end function

sub onNextPressed()
    nextMovie = nextSibling()
    if nextMovie = invalid then return

    pushView(nav.ViewId.movieDetails, {
        movie: nextMovie,
        row: m.params.row,
        index: m.params.index + 1
    })
end sub

sub beginAmbientCountdown()
    resetPlayback()
    startAmbientTimer()
end sub

sub resetPlayback()
    m.bgTimer.control = "stop"

    m.video.callFunc("commitProgress")

    m.video.control = "stop"
    m.video.visible = false

    m.backdropFadeAnim.control = "stop"
    m.overlayFadeAnim.control = "stop"

    m.bgActive = false
    m.fullscreenActive = false

    m.detailsBack.opacity = 1
    m.detailsBottomFade.opacity = 1
    showDetailsChrome(true)
end sub

sub fadeBackdrop(target as float)
    m.backdropFadeAnim.control = "stop"
    m.backdropFadeInterp.keyValue = [m.detailsBack.opacity, target]
    m.backdropFadeAnim.control = "start"
end sub

sub fadeOverlay(target as float)
    m.overlayFadeAnim.control = "stop"
    m.overlayFadeInterp.keyValue = [m.detailsBottomFade.opacity, target]
    m.overlayFadeAnim.control = "start"
end sub

sub startTrailer(fullscreen as boolean)
    content = CreateObject("roSGNode", "ContentNode")

    m.video.overlayTitle = m.meta.text
    m.video.overlayInfo = m.desc.text
    m.video.overlayButtonText = "More Info"

    if fullscreen
        content.url = "https://devstreaming-cdn.apple.com/videos/streaming/examples/bipbop_16x9/bipbop_16x9_variant.m3u8"
        content.streamFormat = "hls"
        content.ClosedCaptions = true

        content.playStart = bookmarks.positionFor(m.currentMovieId)
        logger.info("MovieDetailsView", `resume at ${content.playStart}`)
    else
        content.url = "https://media.w3.org/2010/05/bunny/trailer.mp4"
        content.streamFormat = "mp4"
    end if

    m.video.movieId = m.currentMovieId
    m.video.trackProgress = fullscreen

    if fullscreen
        m.video.trickplayFeed = trickplay.singleFrameFeed(m.backdropUri)
    else
        m.video.trickplayFeed = trickplay.emptyFeed()
    end if

    m.video.suppressCaptions = not fullscreen
    m.video.mute = not fullscreen
    m.video.content = content
    m.video.visible = true
    m.video.control = "play"
end sub

sub onBgTimerFire()
    if m.fullscreenActive or m.bgPlayed then return

    startTrailer(false)
    m.bgActive = true
    m.bgPlayed = true
    fadeBackdrop(0)
end sub

sub onButtonPressed()
    m.bgTimer.control = "stop"

    if m.bgActive
        m.video.control = "stop"
    end if

    startTrailer(true)

    m.bgActive = false
    m.fullscreenActive = true
    m.bgPlayed = true

    m.video.setFocus(true)
    a11y.focus("Playing")

    showDetailsChrome(false)
    fadeBackdrop(0)
    fadeOverlay(0)
end sub

sub onOverlayButtonSelected()
    logger.info("MovieDetailsView", `overlay button selected for movie ${m.currentMovieId}`)
    logger.info("MovieDetailsView", `position ${m.video.position} of ${m.video.duration}, fullscreen ${m.fullscreenActive}`)
end sub

sub onVideoStateChanged()
    state = m.video.state

    if state = "buffering"
        m.videoLoad.callFunc("show")
    else
        m.videoLoad.callFunc("hide")
    end if

    if state = "error"
        failedFullScreen = m.fullscreenActive
        m.trailerFailed = true

        resetPlayback()
        m.button.setFocus(true)

        if failedFullScreen then showPlaybackError()
        return
    end if

    if state = "finished"
        m.video.control = "stop"
        m.video.visible = false

        if m.fullscreenActive
            restoreDetails()
        else if m.bgActive
            m.bgActive = false
            fadeBackdrop(1)
        end if
    end if
end sub

sub showPlayBackError()
    if m.errorDialog <> invalid then return

    dialog = CreateObject("roSGNode", "Dialog")
    dialog.title = "Playback error"
    dialog.message = "We couldn't play this video. Please try again"
    dialog.buttons = ["OK"]

    dialog.observeField("buttonSelected", "onPlaybackErrorDismissed")
    dialog.observeField("wasClosed", "onPlaybackErrorDismissed")

    m.errorDialog = dialog
    m.top.getScene().dialog = dialog

end sub

sub closePlaybackError()
    if m.errorDialog = invalid then return

    m.errorDialog.unobserveField("buttonSelected")
    m.errorDialog.unobserveField("wasClosed")
    m.errorDialog.close = true
    m.errorDialog = invalid
end sub

sub onPlaybackErrorDismissed()
    closePlaybackError()
    m.button.setFocus(true)
end sub

sub restoreDetails()
    m.fullscreenActive = false
    showDetailsChrome(true)
    fadeBackdrop(1)
    fadeOverlay(1)
    m.button.setFocus(true)

    startAmbientTimer()
    a11y.context("Movie details")
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.fullscreenActive and key = "back"
        m.video.callFunc("commitProgress")
        m.video.control = "stop"
        m.video.visible = false
        restoreDetails()
        return true
    end if

    if m.fullscreenActive then return false

    if key = "right" and not m.favButton.hasFocus()
        m.returnFocus = focusedColumnControl()
        m.favButton.setFocus(true)
        return true
    end if

    if key = "left" and m.favButton.hasFocus()
        target = m.returnFocus
        if target = invalid then target = m.button

        target.setFocus(true)
        return true
    end if

    if key = "down" then return moveFocus(1)
    if key = "up" then return moveFocus(-1)

    return false
end function

function focusChain() as object
    chain = [m.button]
    if m.restartButton.visible then chain.Push(m.restartButton)
    if m.nextButton.visible then chain.Push(m.nextButton)

    return chain
end function

function focusedColumnControl() as object
    for each control in focusChain()
        if control.hasFocus() then return control
    end for

    return m.button
end function

function moveFocus(delta as integer) as boolean
    chain = focusChain()

    for idx = 0 to chain.Count() - 1
        if chain[idx].hasFocus()
            target = idx + delta
            if target < 0 or target >= chain.Count() then return false

            chain[target].setFocus(true)
            return true
        end if
    end for

    return false
end function

sub announceScreen()
    parts = ["Movie Details"]

    if m.meta.text <> "" then parts.Push(m.meta.text)

    a11y.context(parts.Join(". "))
end sub

sub startAmbientTimer()
    if m.trailerFailed then return
    if not autoplayAllowed() then return

    m.bgTimer.duration = ambientDelay()
    m.bgPlayed = false
    m.bgTimer.control = "start"
end sub

function autoplayAllowed() as boolean
    info = CreateObject("roDeviceInfo")

    version = info.GetOSVersion()
    if version = invalid then return true

    if Val(version.major) < 13 then return true

    return info.IsAutoplayEnabled() = true
end function

function ambientDelay() as float
    if m.global.screenReaderOn = true then return 12
    return 5
end function
