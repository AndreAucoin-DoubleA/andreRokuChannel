import "pkg:/source/theme/theme.bs"
import "pkg:/source/services/favorites.bs"
import "pkg:/source/services/bookmarks.bs"
import "pkg:/source/services/a11y.bs"

sub init()
    m.meta = m.top.findNode("meta")
    m.desc = m.top.findNode("desc")
    m.scrim = m.top.findNode("scrim")
    m.detailsBack = m.top.findNode("detailsBack")
    m.detailsBottomFade = m.top.findNode("detailsBottomFade")

    m.button = m.top.findNode("playButton")
    m.button.observeField("selected", "onButtonPressed")

    m.nextButton = m.top.findNode("nextButton")
    m.nextButton.observeField("selected", "onNextPressed")

    m.restartButton = m.top.findNode("restartButton")
    m.restartButton.observeField("selected", "onRestartPress")

    m.favButton = m.top.findNode("detailsFav")
    m.favButton.observeField("favorited", "onFavoriteToggled")

    m.backdropFadeAnim = m.top.findNode("backdropFadeAnim")
    m.backdropFadeInterp = m.top.findNode("backdropFadeInterp")
    m.overlayFadeAnim = m.top.findNode("overlayFadeAnim")
    m.overlayFadeInterp = m.top.findNode("overlayFadeInterp")

    m.bgTimer = m.top.findNode("bgPlayTimer")
    m.bgTimer.observeField("fire", "onBgTimerFire")

    m.video = m.top.findNode("videoPlayer")
    m.video.observeField("state", "onVideoStateChanged")

    m.video.notificationInterval = 1
    m.video.observeField("position", "onVideoPositionChanged")

    m.bgActive = false
    m.fullscreenActive = false
    m.bgPlayed = false
    m.trailerFailed = false
    m.params = {}
    m.currentMovieId = ""
    m.returnFocus = invalid
    m.errorDialog = invalid
    m.autoPlay = false

    m.lastPosition = 0
    m.videoDuration = 0
    m.ticksSinceSave = 0
    m.trackPosition = false

    applyTheme()
end sub

sub renderButtons()
    canResume = bookmarks.positionFor(m.currentMovieId) > 0

    if canResume
        m.button.text = "Resume"
    else
        m.button.text = "Play"
    end if

    m.restartButton.visible = canResume

    m.nextButton.translation = [110, 640]
    if canResume then m.nextButton.translation = [110, 730]
end sub

sub showDetailsChrome(show as boolean)
    m.meta.visible = show
    m.desc.visible = show
    m.button.visible = show
    m.favButton.visible = show

    if show
        m.nextButton.visible = (nextSibling() <> invalid)
        renderButtons()
    else
        m.nextButton.visible = false
        m.restartButton.visible = false
    end if
end sub

sub onRestartPress()
    bookmarks.clear(m.currentMovieId)
    onButtonPressed()
end sub

sub applyTheme()
    t = theme.Theme()

    m.scrim.color = t.color("component.movieDetails.scrimColor", "0x202226FF")
    m.scrim.opacity = t.number("component.movieDetails.scrimOpacity", 0.96)

    m.detailsBottomFade.blendColor = t.color("component.movieDetails.bottomFadeBlendColor", "0xFFFF6DFF")

    m.meta.color = t.color("component.movieDetails.metaColor", "0xB7BDC5FF")
    m.meta.font = t.font("component.movieDetails.metaTypography", "font:MediumSystemFont")

    m.desc.color = t.color("component.movieDetails.descriptionColor", "0xDDE0E4FF")
    m.desc.font = t.font("component.movieDetails.descriptionTypography", "font:MediumSystemFont")
end sub

sub viewDidLoad(params as object)
    m.params = params
    m.autoPlay = (params.autoPlay = true)
    applyMovie(params.movie)
    m.nextButton.visible = (nextSibling() <> invalid)
    announceScreen()
end sub
sub viewWillAppear()
    beginAmbientCountdown()

    if m.autoPlay
        m.autoPlay = false
        onButtonPressed()
    end if
end sub

sub viewWillHide()
    persistPosition()
    resetPlayback()
    closePlaybackError()
end sub

sub viewWillDisappear()
    persistPosition()
    resetPlayback()
    closePlaybackError()
end sub

function setViewFocus() as boolean
    if m.fullscreenActive then return m.video.setFocus(true)
    return m.button.setFocus(true)
end function

sub applyMovie(movie as object)
    if movie = invalid then return

    m.meta.text = movie.title + "  -  Rating: " + movie.rating + "  -  Released: " + movie.releaseDate
    m.desc.text = movie.description
    m.detailsBack.uri = movie.HDBackgroundImageUrl

    m.currentMovieId = movie.movieId
    if m.currentMovieId = invalid then m.currentMovieId = ""

    m.favButton.favorited = favorites.isFavorite(m.currentMovieId)
end sub

sub onFavoriteToggled()
    if m.currentMovieId = "" then return

    favorited = m.favButton.favorited

    if favorited = favorites.isFavorite(m.currentMovieId) then return

    favorites.setFavorite(m.currentMovieId, favorited)
end sub

function nextSibling() as object
    if m.params.row = invalid or m.params.index = invalid then return invalid
    return m.params.row.getChild(m.params.index + 1)
end function

sub onNextPressed()
    nextMovie = nextSibling()
    if nextMovie = invalid then return

    pushView("MovieDetailsView", {
        movie: nextMovie,
        row: m.params.row,
        index: m.params.index + 1
    })
end sub

sub beginAmbientCountdown()
    resetPlayback()
    if m.trailerFailed then return
    m.bgPlayed = false
    m.bgTimer.control = "start"
end sub

sub resetPlayback()
    m.bgTimer.control = "stop"
    m.video.control = "stop"
    m.video.visible = false

    m.backdropFadeAnim.control = "stop"
    m.overlayFadeAnim.control = "stop"

    m.bgActive = false
    m.fullscreenActive = false

    m.detailsBack.opacity = 1
    m.detailsBottomFade.opacity = 1
    showDetailsChrome(true)
end sub

sub fadeBackdrop(target as float)
    m.backdropFadeAnim.control = "stop"
    m.backdropFadeInterp.keyValue = [m.detailsBack.opacity, target]
    m.backdropFadeAnim.control = "start"
end sub

sub fadeOverlay(target as float)
    m.overlayFadeAnim.control = "stop"
    m.overlayFadeInterp.keyValue = [m.detailsBottomFade.opacity, target]
    m.overlayFadeAnim.control = "start"
end sub

sub startTrailer(fullscreen as boolean)
    content = CreateObject("roSGNode", "ContentNode")

    if fullscreen
        content.url = "https://devstreaming-cdn.apple.com/videos/streaming/examples/bipbop_16x9/bipbop_16x9_variant.m3u8"
        content.streamFormat = "hls"
        content.ClosedCaptions = true
    else
        content.url = "https://media.w3.org/2010/05/bunny/trailer.mp4"
        content.streamFormat = "mp4"
    end if

    m.trackPosition = fullscreen

    if fullscreen
        content.playStart = bookmarks.positionFor(m.currentMovieId)
    else
        content.playStart = 0
    end if

    m.video.suppressCaptions = not fullscreen
    m.video.mute = not fullscreen
    m.video.content = content
    m.video.visible = true
    m.video.control = "play"
end sub

sub onBgTimerFire()
    if m.fullscreenActive or m.bgPlayed then return

    startTrailer(false)
    m.bgActive = true
    m.bgPlayed = true
    fadeBackdrop(0)
end sub

sub onButtonPressed()
    m.bgTimer.control = "stop"

    if m.bgActive
        m.video.control = "stop"
    end if

    startTrailer(true)

    m.bgActive = false
    m.fullscreenActive = true
    m.bgPlayed = true

    m.video.setFocus(true)
    a11y.focus("Playing")

    showDetailsChrome(false)
    fadeBackdrop(0)
    fadeOverlay(0)
end sub

sub onVideoStateChanged()
    state = m.video.state

    if state = "error"
        failedFullScreen = m.fullscreenActive
        m.trailerFailed = true

        persistPosition()
        resetPlayback()
        m.button.setFocus(true)

        if failedFullScreen then showPlaybackError()
        return
    end if

    if state = "paused"
        savePositionNow()
        return
    end if

    if state = "finished"
        persistPosition()
        m.video.control = "stop"
        m.video.visible = false

        if m.fullscreenActive
            restoreDetails()
        else if m.bgActive
            m.bgActive = false
            fadeBackdrop(1)
        end if
    end if
end sub

sub showPlayBackError()
    if m.errorDialog <> invalid then return

    dialog = CreateObject("roSGNode", "Dialog")
    dialog.title = "Playback error"
    dialog.message = "We couldn't play this video. Please try again"
    dialog.buttons = ["OK"]

    dialog.observeField("buttonSelected", "onPlaybackErrorDismissed")
    dialog.observeField("wasClosed", "onPlaybackErrorDismissed")

    m.errorDialog = dialog
    m.top.getScene().dialog = dialog

end sub

sub closePlaybackError()
    if m.errorDialog = invalid then return

    m.errorDialog.unobserveField("buttonSelected")
    m.errorDialog.unobserveField("wasClosed")
    m.errorDialog.close = true
    m.errorDialog = invalid
end sub

sub onPlaybackErrorDismissed()
    closePlaybackError()
    m.button.setFocus(true)
end sub

sub restoreDetails()
    m.fullscreenActive = false
    showDetailsChrome(true)
    fadeBackdrop(1)
    fadeOverlay(1)
    m.button.setFocus(true)

    m.bgPlayed = false
    m.bgTimer.control = "start"
    a11y.context("Movie details")
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if m.fullscreenActive and key = "back"
        persistPosition()
        m.video.control = "stop"
        m.video.visible = false
        restoreDetails()
        return true
    end if

    if m.fullscreenActive then return false

    if key = "right" and not m.favButton.hasFocus()
        m.returnFocus = focusedColumnControl()
        m.favButton.setFocus(true)
        return true
    end if

    if key = "left" and m.favButton.hasFocus()
        target = m.returnFocus
        if target = invalid then target = m.button

        target.setFocus(true)
        return true
    end if

    if key = "down" then return moveFocus(1)
    if key = "up" then return moveFocus(-1)

    return false
end function

function focusChain() as object
    chain = [m.button]
    if m.restartButton.visible then chain.Push(m.restartButton)
    if m.nextButton.visible then chain.Push(m.nextButton)

    return chain
end function

function focusedColumnControl() as object
    for each control in focusChain()
        if control.hasFocus() then return control
    end for

    return m.button
end function

function moveFocus(delta as integer) as boolean
    chain = focusChain()

    for idx = 0 to chain.Count() - 1
        if chain[idx].hasFocus()
            target = idx + delta
            if target < 0 or target >= chain.Count() then return false

            chain[target].setFocus(true)
            return true
        end if
    end for

    return false
end function

sub onVideoPositionChanged()
    if not m.trackPosition then return

    m.lastPosition = m.video.position
    m.videoDuration = m.video.duration

    m.ticksSinceSave = m.ticksSinceSave + 1
    if m.ticksSinceSave < 15 then return

    m.ticksSinceSave = 0
    savePositionNow()
end sub

sub savePositionNow()
    position = m.video.position
    duration = m.video.duration

    if position <= 0 then position = m.lastPosition
    if duration <= 0 then duration = m.videoDuration

    if position <= 0 then return

    bookmarks.savePosition(m.currentMovieId, position, duration)
end sub

sub persistPosition()
    if not m.trackPosition then return

    savePositionNow()

    m.lastPosition = 0
    m.ticksSinceSave = 0
    m.trackPosition = false
end sub

sub announceScreen()
    parts = ["Movie Details"]

    if m.meta.text <> "" then parts.Push(m.meta.text)

    if m.desc.text <> "" then parts.Push(m.desc.text)

    a11y.context(parts.Join(". "))
end sub
