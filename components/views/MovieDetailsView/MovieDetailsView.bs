import "pkg:/source/theme/theme.bs"
import "pkg:/source/services/bookmarks.bs"
import "pkg:/source/services/a11y.bs"
import "pkg:/source/navigation/nav.interface.bs"
import "pkg:/source/utils/logger.bs"
import "pkg:/components/tasks/FetchMovieTask/FetchMovieTask.interface.bs"
import "pkg:/components/views/MovieDetailsView/MovieDetailsView.interface.bs"
import "pkg:/source/services/watchlist.bs"
import "pkg:/source/data/trailers.bs"

const LOGO_INSET = 80
const DESC_RIGHT_EDGE = 1530
const DESC_MAX_LINES = 3
const TITLE_FONT_SIZE = 48
const RATING_FONT_SIZE = 16
const RATING_MIN_WIDTH = 43
const RATING_PAD_X = 14
const RATING_UNKNOWN = "N/A"

const WATCHLIST_ADD_ICON = "pkg:/assets/images/addUnfill/Add_unfill@2x-1.png"
const WATCHLIST_ADD_ICON_FOCUSED = "pkg:/assets/images/addFill/Add_fill@2x-1.png"
const WATCHLIST_REMOVE_ICON = "pkg:/assets/images/remove/Remove@2x-1.png"

const CONTENT_SHIFT_Y = -160


sub init()
    m.top.translation = [-m.global.contentOffsetX, 0]
    m.title = m.top.findNode("title")
    m.metaRow = m.top.findNode("metaRow")
    m.metaYear = m.top.findNode("metaYear")
    m.ratingPill = m.top.findNode("ratingPill")
    m.ratingPillBg = m.top.findNode("ratingPillBg")
    m.ratingText = m.top.findNode("ratingText")
    m.metaRuntime = m.top.findNode("metaRuntime")
    m.desc = m.top.findNode("desc")
    m.cast = m.top.findNode("cast")
    m.scrim = m.top.findNode("scrim")
    m.detailsBack = m.top.findNode("detailsBack")
    m.detailsBottomFade = m.top.findNode("detailsBottomFade")

    m.detailsLoad = m.top.findNode("detailsLoad")
    m.enrichFadeAnim = m.top.findNode("enrichFadeAnim")
    m.shiftAnim = m.top.findNode("shiftAnim")
    m.shiftInterp = m.top.findNode("shiftInterp")
    m.detailsContent = m.top.findNode("detailsContent")

    m.trailerRows = m.top.findNode("trailerRows")
    m.trailerRows.observeField("selectedMovie", "onTrailerSelected")

    m.buttonRow = m.top.findNode("buttonRow")

    m.button = m.top.findNode("playButton")
    m.button.observeField("selected", "onButtonPressed")

    m.watchlistButton = m.top.findNode("watchlistButton")
    m.watchlistButton.observeField("selected", "onWatchlistPressed")

    m.movie = invalid
    m.currentMovieId = ""
    m.backdropUri = ""
    m.detailsTask = invalid

    layoutContent()
    applyTheme()
end sub

sub layoutContent()
    m.leftEdge = 96

    m.title.translation = [m.leftEdge, 200]

    m.metaRow.translation = [m.leftEdge, 290]

    m.desc.translation = [m.leftEdge, 340]
    m.desc.width = DESC_RIGHT_EDGE - m.leftEdge
    m.desc.maxLines = DESC_MAX_LINES

    m.cast.translation = [m.leftEdge, 540]
    m.cast.width = DESC_RIGHT_EDGE - m.leftEdge
    m.cast.maxLines = 1

    m.buttonRow.translation = [m.leftEdge, 640]

    m.trailerRows.translation = [m.leftEdge - 4, 720]
end sub

sub renderButtons()
    canResume = bookmarks.positionFor(m.currentMovieId) > 0

    if canResume
        m.button.text = "Resume"
    else
        m.button.text = "Play"
    end if

    renderWatchlistButton()
end sub

sub renderWatchlistButton()
    if watchlist.contains(m.currentMovieId)
        m.watchlistButton.text = "Remove"
        m.watchlistButton.iconUri = WATCHLIST_REMOVE_ICON
        m.watchlistButton.iconUriFocused = WATCHLIST_REMOVE_ICON
    else
        m.watchlistButton.text = "Watchlist"
        m.watchlistButton.iconUri = WATCHLIST_ADD_ICON
        m.watchlistButton.iconUriFocused = WATCHLIST_ADD_ICON_FOCUSED
    end if
end sub

sub applyTheme()
    t = theme.current()

    m.scrim.color = t.color("component.movieDetails.scrimColor", "0x202226FF")
    m.scrim.opacity = t.number("component.movieDetails.scrimOpacity", 0.96)

    m.detailsBottomFade.blendColor = t.color("component.movieDetails.bottomFadeBlendColor", "0xFFFF6DFF")

    m.title.color = t.color("component.movieDetails.titleColor", "0xE1E5E6FF")
    m.title.font = interFont("Inter Bold", TITLE_FONT_SIZE, t.font("component.movieDetails.titleTypography", "font:LargeBoldSystemFont"))

    metaColor = t.color("component.movieDetails.metaColor", "0xB7BDC5FF")
    metaFont = t.font("component.movieDetails.metaTypography", "font:MediumSystemFont")

    m.metaYear.color = metaColor
    m.metaYear.font = metaFont

    m.metaRuntime.color = metaColor
    m.metaRuntime.font = metaFont

    m.ratingPillBg.blendColor = t.color("component.movieDetails.ratingPillColor", "0x909294FF")
    m.ratingText.color = t.color("component.movieDetails.ratingTextColor", "0x101018FF")
    m.ratingText.font = interFont("Inter Bold", RATING_FONT_SIZE, t.font("component.movieDetails.ratingTypography", "font:SmallBoldSystemFont"))

    m.desc.color = t.color("component.movieDetails.descriptionColor", "0xDDE0E4FF")
    m.desc.font = t.font("component.movieDetails.descriptionTypography", "font:MediumSystemFont")

    m.cast.color = t.color("component.movieDetails.castColor", "0xB7BDC5FF")
    m.cast.font = t.font("component.movieDetails.castTypography", "font:MediumSystemFont")
end sub

function interFont(family as string, size as integer, fallback as dynamic) as object
    uri = theme.FontUri(family)
    if uri = "" then return fallback

    font = CreateObject("roSGNode", "Font")
    font.uri = uri
    font.size = size

    return font
end function

sub viewDidLoad(params as movieDetails.Params)
    applyMovie(params.movie)
    announceScreen()
end sub
sub viewWillAppear()
    renderButtons()
end sub

sub viewWillHide()
end sub

sub viewWillDisappear()
    cancelDetailsFetch()
end sub

function setViewFocus() as boolean
    applyShift(false, false)

    return m.button.setFocus(true)
end function

sub applyMovie(movie as object)
    if movie = invalid then return

    m.movie = movie
    m.trailerRows.visible = false
    applyShift(false, false)
    enriched = isEnriched(movie)

    m.title.text = movie.title
    applyMeta(movie, enriched)
    m.desc.text = movie.description
    m.cast.text = castLine(movie)

    if enriched
        showContent(false)
    else
        hideContent()
    end if

    m.backdropUri = ""
    if movie.HDBackgroundImageUrl <> invalid then m.backdropUri = movie.HDBackgroundImageUrl

    m.detailsBack.uri = m.backdropUri

    m.currentMovieId = movie.movieId
    if m.currentMovieId = invalid then m.currentMovieId = ""

    requestFullDetails(movie)
end sub

function releaseYear(releaseDate as dynamic) as string
    if releaseDate = invalid then return ""
    if Len(releaseDate) < 4 then return ""

    return Left(releaseDate, 4)
end function

function runtimeText(minutes as dynamic) as string
    if minutes = invalid then return ""
    if minutes <= 0 then return ""

    hours = Int(minutes / 60)
    mins = minutes mod 60

    if hours = 0 then return mins.ToStr() + "m"
    if mins = 0 then return hours.ToStr() + "h"

    return hours.ToStr() + "h " + mins.ToStr() + "m"
end function

function castLine(movie as object) as string
    if movie.cast = invalid then return ""
    if movie.cast = "" then return ""

    return "Starring: " + movie.cast
end function

sub applyMeta(movie as object, resolved as boolean)
    if movie = invalid then return

    m.metaYear.text = releaseYear(movie.releaseDate)

    cert = ""
    if movie.certification <> invalid then cert = movie.certification
    if cert = "" and not resolved
        m.ratingPill.visible = false
    else
        if cert = "" then cert = RATING_UNKNOWN

        m.ratingText.text = cert
        sizeRatingPill()
        m.ratingPill.visible = true
    end if

    m.metaRuntime.text = runtimeText(movie.runtimeMinutes)
end sub

function isEnriched(movie as object) as boolean
    if movie = invalid then return false
    if movie.runtimeMinutes = invalid then return false

    return movie.runtimeMinutes > 0
end function

sub hideContent()
    m.enrichFadeAnim.control = "stop"
    m.detailsContent.opacity = 0
end sub

sub showContent(animate as boolean)
    m.enrichFadeAnim.control = "stop"

    if not animate
        m.detailsContent.opacity = 1
        return
    end if

    m.detailsContent.opacity = 0
    m.enrichFadeAnim.control = "start"
end sub

sub applyShift(shifted as boolean, animate as boolean)
    target = [0, 0]
    if shifted then target = [0, CONTENT_SHIFT_Y]

    m.shiftAnim.control = "stop"

    if not animate
        m.detailsContent.translation = target
        return
    end if

    m.shiftInterp.keyValue = [m.detailsContent.translation, target]
    m.shiftAnim.control = "start"
end sub

sub sizeRatingPill()
    textWidth = m.ratingText.localBoundingRect().width

    pillWidth = textWidth + (RATING_PAD_X * 2)
    if pillWidth < RATING_MIN_WIDTH then pillWidth = RATING_MIN_WIDTH

    m.ratingPillBg.width = pillWidth
    m.ratingText.translation = [(pillWidth - textWidth) / 2, 0]
end sub

function spokenMeta() as string
    parts = []

    if m.metaYear.text <> "" then parts.Push(m.metaYear.text)
    if m.ratingText.text = RATING_UNKNOWN
        parts.Push("not rated")
    else if m.ratingText.text <> ""
        parts.Push("rated " + m.ratingText.text)
    end if
    if m.metaRuntime.text <> "" then parts.Push(m.metaRuntime.text)

    return parts.Join(", ")
end function

sub requestFullDetails(movie as object)
    if m.currentMovieId = "" then return

    if isEnriched(movie) then return

    cancelDetailsFetch()

    task = CreateObject("roSGNode", "FetchMovieTask")
    task.movieId = m.currentMovieId
    task.observeField("status", "onFullDetailsResolved")
    m.detailsTask = task

    m.detailsLoad.callFunc("show")
    task.control = "RUN"
end sub

sub cancelDetailsFetch()
    m.detailsLoad.callFunc("hide")

    if m.detailsTask = invalid then return

    m.detailsTask.unobserveField("status")
    m.detailsTask.control = "stop"
    m.detailsTask = invalid
end sub

sub onFullDetailsResolved(msg as object)
    task = msg.GetRoSGNode()
    status = msg.GetData()

    m.detailsTask = invalid
    m.detailsLoad.callFunc("hide")

    movie = invalid
    trailerContent = invalid

    if status = tasks.Status.ok
        movie = task.movie
        trailerContent = task.trailers
    end if

    applyTrailers(trailerContent)
    applyFullDetails(movie)
end sub

sub applyFullDetails(movie as object)
    if movie = invalid
        applyMeta(m.movie, true)
        showContent(true)
        return
    end if

    if movie.movieId <> m.currentMovieId then return

    applyMeta(movie, true)
    m.title.text = movie.title
    m.desc.text = movie.description
    m.cast.text = castLine(movie)
    showContent(true)
    announceScreen()
end sub

sub onButtonPressed()
    pushView(nav.ViewId.player, {
        movieId: m.currentMovieId,
        title: m.title.text,
        description: m.desc.text,
        backdropUri: m.backdropUri
    })
end sub

sub announceScreen()
    parts = ["Movie Details"]

    if m.title.text <> "" then parts.Push(m.title.text)

    facts = spokenMeta()
    if facts <> "" then parts.Push(facts)

    a11y.context(parts.Join(". "))
end sub

sub onWatchlistPressed()
    if m.movie = invalid then return

    added = watchlist.toggle(m.movie)

    renderWatchlistButton()

    if added
        a11y.context(`${m.title.text} added to ${watchlist.ROW_TITLE}`)
    else
        a11y.context(`${m.title.text} removed from ${watchlist.ROW_TITLE}`)
    end if

    logger.info("MovieDetailsView", `watchlist ${added} for ${m.currentMovieId}`)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "down" and not m.trailerRows.isInFocusChain()
        if not hasTrailers() then return false

        applyShift(true, true)

        return m.trailerRows.callFunc("focusRows")
    end if

    if key = "up" and m.trailerRows.isInFocusChain()
        applyShift(false, true)

        return m.button.setFocus(true)
    end if

    if key = "right" then return moveFocus(1)
    if key = "left" then return moveFocus(-1)

    return false
end function

function focusChain() as object
    chain = []

    if m.button.visible then chain.Push(m.button)
    if m.watchlistButton.visible then chain.Push(m.watchlistButton)

    return chain
end function

function moveFocus(delta as integer) as boolean
    chain = focusChain()

    for idx = 0 to chain.Count() - 1
        if chain[idx].hasFocus()
            target = idx + delta
            if target < 0 or target >= chain.Count() then return false

            chain[target].setFocus(true)
            return true
        end if
    end for

    return false
end function

sub applyTrailers(content as object)
    if content = invalid
        m.trailerRows.visible = false
        return
    end if

    m.trailerRows.content = content
    m.trailerRows.visible = (content.getChildCount() > 0)
end sub

function hasTrailers() as boolean
    if not m.trailerRows.visible then return false

    content = m.trailerRows.content
    if content = invalid then return false

    return content.getChildCount() > 0
end function

sub onTrailerSelected()
    trailer = m.trailerRows.selectedMovie
    if trailer = invalid then return

    pushView(nav.ViewId.player, {
        movieId: m.currentMovieId,
        title: trailer.title,
        description: m.title.text,
        backdropUri: trailer.HDBackgroundImageUrl,
        streamUrl: trailer.streamUrl,
        streamFormat: trailer.streamFormat,
        trackProgress: false
    })
end sub
