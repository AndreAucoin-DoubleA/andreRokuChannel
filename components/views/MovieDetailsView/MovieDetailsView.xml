<?xml version="1.0" encoding="utf-8"?>
<component name="MovieDetailsView" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/views/MovieDetailsView/MovieDetailsView.bs"/>

    <interface>
        <!-- Exposed for tests: focus order, a11y and playback internals. -->
        <function name="focusChain"/>
        <function name="focusedColumnControl"/>
        <function name="moveFocus"/>
        <function name="announceScreen"/>
        <function name="nextSibling"/>
        <function name="applyMovie"/>
        <function name="onFavoriteToggled"/>
        <function name="autoplayAllowed"/>
        <function name="ambientDelay"/>
        <function name="resetPlayback"/>
        <function name="showDetailsChrome"/>
        <function name="onButtonPressed"/>
        <function name="onVideoStateChanged"/>
        <function name="onPlaybackErrorDismissed"/>
        <function name="closePlaybackError"/>
        <function name="restoreDetails"/>
    </interface>

    <children>
        <Rectangle id="scrim" width="1920" height="1080"/>

        <VideoPlayer
            id="videoPlayer"
            width="1920"
            height="1080"
            visible="false"/>

        <Poster
            id="detailsBack"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToZoom"/>

        <Poster
            id="detailsBottomFade"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToFill"
            uri="pkg:/assets/images/details_bottom_fade_overlay.png"/>

        <Animation id="backdropFadeAnim" duration="0.4" easeFunction="inOutQuad">
            <FloatFieldInterpolator
                id="backdropFadeInterp"
                key="[0,1]"
                keyValue="[1,1]"
                fieldToInterp="detailsBack.opacity"/>
        </Animation>

        <Animation id="overlayFadeAnim" duration="0.4" easeFunction="inOutQuad">
            <FloatFieldInterpolator
                id="overlayFadeInterp"
                key="[0,1]"
                keyValue="[1,1]"
                fieldToInterp="detailsBottomFade.opacity"/>
        </Animation>

        <Timer id="bgPlayTimer" duration="5" repeat="false"/>

        <Label
            id="meta"
            translation="[430,550]"/>

        <Label
            id="desc"
            translation="[430,650]"
            width="1100"
            wrap="true"/>

        <TextButton
            id="playButton"
            text="Play"
            width="260"
            translation="[110, 550]"/>

        <FavoriteToggle
            id="detailsFav"
            translation="[1740, 550]"/>

        <TextButton id="restartButton" text="Start Over" width="260"
            translation="[110,640]" visible="false"/>

        <TextButton id="nextButton" text="Next in row" width="260"
            translation="[110,640]" visible="false"/>
        
        <LoadingIndicator
            id="videoLoad"
            translation="[910,490]"
            timeout="0"
            errorMessage="Couldn't load content"/>
    </children>
</component>
