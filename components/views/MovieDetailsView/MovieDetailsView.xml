<?xml version="1.0" encoding="utf-8"?>
<component name="MovieDetailsView" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/views/MovieDetailsView/MovieDetailsView.bs"/>

    <interface>
        <function name="focusChain"/>
        <function name="moveFocus"/>
        <function name="announceScreen"/>
        <function name="applyMovie"/>
    </interface>

    <children>
        <Rectangle id="scrim" width="1920" height="1080"/>

        <Poster
            id="detailsBack"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToZoom"/>

        <Poster
            id="detailsBottomFade"
            width="1920"
            height="1080"
            loadDisplayMode="scaleToFill"
            uri="pkg:/assets/images/details_bottom_fade_overlay.png"/>

        <Label
            id="title"
            width="900"
            height="66"
            opacity="1"
            vertAlign="center"/>

        <LayoutGroup
            id="metaRow"
            layoutDirection="horiz"
            vertAlignment="center"
            itemSpacings="[25]">
            <Label
                id="metaYear"
                height="34"
                vertAlign="center"/>

            <Group id="ratingPill">
                <Poster
                    id="ratingPillBg"
                    width="43"
                    height="34"
                    opacity="1"
                    uri="pkg:/assets/images/rating_pill.9.png"/>

                <Label
                    id="ratingText"
                    height="34"
                    vertAlign="center"/>
            </Group>

            <Label
                id="metaRuntime"
                height="34"
                vertAlign="center"/>
        </LayoutGroup>

        <Label
            id="desc"
            wrap="true"/>

        <Label
            id="cast"
            wrap="true"/>

        <LayoutGroup
            id="buttonRow"
            layoutDirection="horiz"
            vertAlignment="center"
            itemSpacings="[25]">
                <TextButton
                    id="playButton"
                    text="Play"
                    width="184"
                    height="74"
                    iconUri="pkg:/assets/images/play/Play@2x-1.png"/>
        
                <TextButton
                    id="watchlistButton"
                    text="Watchlist"
                    width="184"
                    height="74"
                    iconTint="false"
                    iconUri="pkg:/assets/images/addUnfill/Add_unfill@2x-1.png"
                    iconUriFocused="pkg:/assets/images/addFill/Add_fill@2x-1.png"/>
        </LayoutGroup>
    </children>
</component>
