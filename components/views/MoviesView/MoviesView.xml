<?xml version="1.0" encoding="utf-8"?>
<component name="MoviesView" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/views/MoviesView/MoviesView.bs"/>
    <children>
        <Group id="heroGroup" opacity="0">
            <MaskGroup
                id="itemSelectBackgroundMask"
                translation="[460, 0]"
                maskUri="pkg:/images/backdrop_corner_fade.png"
                maskSize="[1460,680]"
                maskOffset="[0,0]">
                <Poster
                    id="itemSelectBackground"
                    width="1460"
                    height="680"
                    loadDisplayMode="scaleToZoom"/>
            </MaskGroup>

            <Poster
                id="movieLogo"
                translation="[100, 140]"
                width="420"
                height="140"
                loadDisplayMode="scaleToFit"
                visible="false"/>

            <Label
                id="movieTitleLabel"
                translation="[100, 140]"
                width="420"
                height="140"
                font="font:LargeBoldSystemFont"
                color="#FFFFFF"
                vertAlign="top"
                wrap="true"
                visible="false"/>
        </Group>

        <Animation id="heroFadeAnim" duration="0.35" easeFunction="outQuad">
            <FloatFieldInterpolator
                id="heroFadeOpacityInterp"
                key="[0,1]"
                keyValue="[0,1]"
                fieldToInterp="heroGroup.opacity"/>
        </Animation>

        <Timer id="heroDebounce" duration="0.3" repeat="false"/>

        <Timer id="inputGateTimeout" duration="8" repeat="false"/>

        <MovieRowList
            id="movieRows"
            translation="[40, 500]"
            rowSpacing="115"/>

        <LoadingIndicator
            id="loader"
            translation="[752,492]"
            message="Loading movies..."
            errorMessage="Couldn't load movies"/>

        <Poster
            id="rightFade"
            translation="[1570,0]"
            width="400"
            height="1080"
            loadDisplayMode="scaleToFill"
            uri="pkg:/images/movies_right_fade.png"/>
    </children>
</component>
