<?xml version="1.0" encoding="utf-8"?>
<component name="MultiviewView" extends="BaseView">
    <script type="text/brightscript" uri="pkg:/components/views/MultiviewView/MultiviewView.bs" />
    <children>
        <Label
            id="titleLabel"
            translation="[40,80]"
            text="Multiview"/>
        
        <Label
            id="bodyLabel"
            translation="[40,170]"
            width="1200"
            wrap="true"
            text="Four camera feeds composited into one synchronised stream. Arrow keys change which feed you hear. Press OK to zoom a feed to full screen."/>

        <TextButton
            id="startButton"
            text="Start Multivew Button"
            width="440"
            translation="[40,340]"
            audioGuideText="Start multiview demo"/>
        
        <Label
            id="statusLabel"
            translation="[40,450]"
            width="1200"
            wrap="true"/>
    </children>
    
</component>