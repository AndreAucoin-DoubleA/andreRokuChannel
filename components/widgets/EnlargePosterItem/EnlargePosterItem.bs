sub init()
    m.poster = m.top.findNode("poster")
    m.scrimHorizontal = m.top.findNode("scrimHorizontal")
    m.scrimVertical = m.top.findNode("scrimVertical")
    m.itemLabel = m.top.findNode("itemLabel")
end sub

sub onSizeChanged()
    tempWidth = m.top.width
    tempHeight = m.top.height

    if tempWidth <= 0 or tempHeight <= 0 then return

    m.poster.width = tempWidth
    m.poster.height = tempHeight
    m.poster.loadWidth = tempWidth
    m.poster.loadHeight = tempHeight

    m.scrimHorizontal.width = tempWidth
    m.scrimHorizontal.height = tempHeight

    m.scrimVertical.width = tempWidth
    m.scrimVertical.height = tempHeight
end sub

sub onContentChanged()
    content = m.top.itemContent

    if content = invalid
        m.poster.uri = ""
        m.itemLabel.text = ""
        return
    end if

    m.poster.uri = content.HDPosterUrl
    m.itemLabel.text = content.title
end sub
