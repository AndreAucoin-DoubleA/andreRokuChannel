<?xml version="1.0" encoding="utf-8"?>
<component name="EnlargePosterItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/EnlargePosterItem/EnlargePosterItem.bs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
        <field id="width" type="float" onChange="onSizeChanged" />
        <field id="height" type="float" onChange="onSizeChanged" />
        <field id="rowListHasFocus" type="boolean" onChange="onRowListFocusChanged" />
    </interface>

    <children>
        <Poster
            id="poster"
            loadDisplayMode="scaleToZoom"
            failedBitmapUri="pkg:/assets/images/demo_image.jpg" />

        <Poster
            id="scrimHorizontal"
            loadDisplayMode="scaleToFill"
            uri="pkg:/assets/images/hero_scrim_horizontal.png" />

        <Poster
            id="scrimVertical"
            loadDisplayMode="scaleToFill"
            uri="pkg:/assets/images/hero_scrim_vertical.png" />

        <Label
            id="itemLabel"
            wrap="true"
            maxLines="1"
            ellipsizeOnBoundary="true"
            horizAlign="left"
            vertAlign="top"
            translation="[460,250]"
            width="900" />

        <Label
            id="itemDescription"
            wrap="true"
            maxLines="3"
            ellipsizeOnBoundary="true"
            horizAlign="left"
            vertAlign="top"
            translation="[460,340]"
            width="665"/>

        <Group id="cta" translation="[460,488]">
            <Poster
                id="ctaFill"
                uri="pkg:/assets/images/cta_pill.9.png"
                width="255"
                height="72" />
            <Label
                id="ctaLabel"
                text="More Info"
                width="255"
                height="72"
                horizAlign="center"
                vertAlign="center" />
        </Group>
    </children>
</component>

