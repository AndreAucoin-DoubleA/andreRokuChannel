<?xml version="1.0" encoding="utf-8"?>
<component name="EnlargeRowList" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/EnlargeRowList/EnlargeRowList.bs" />

    <interface>
        <field id="content" type="node" onChange="onContentChanged" />
        <field id="selectedMovie" type="node" alwaysNotify="true"/>
        <field id="selectedRow" type="node"/>
        <field id="selectedIndex" type="integer" value="-1"/>
        <function name="focusRows" />
    </interface>

    <children>
        <RowList
            id="rowList"
            translation="[0,0]"
            showRowLabel="false"
            itemComponentName="EnlargePosterItem"
            numRows="1"
            rowFocusAnimationStyle="fixedFocus"
            vertFocusAnimationStyle="fixedFocus"
            drawFocusFeedback="false"
            itemSize="[1920,1080]"
            rowItemSize="[[1920,1080]]"
            rowItemSpacing="[[10,0]]" />

        <Group id="preload" opacity="0">
            <Poster
                id="preloadNext"
                width="1920"
                height="1080"
                loadDisplayMode="scaleToZoom" />
            <Poster
                id="preloadPrev"
                width="1920"
                height="1080"
                loadDisplayMode="scaleToZoom" />
        </Group>

        <PageIndicator id="pageIndicator"/>
    </children>
</component>
