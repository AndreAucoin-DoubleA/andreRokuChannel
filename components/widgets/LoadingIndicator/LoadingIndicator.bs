import "pkg:/source/operations/loadingOps.bs"

sub init()
    m.ctx = loadingOps.newContext(m.top)

    m.ctx.spinner.poster.uri = "pkg:/assets/images/shubi-spinner.png"
    m.ctx.spinner.poster.width = 100
    m.ctx.spinner.poster.height = 100

    m.ctx.delayTimer.observeField("fire", "onDelayFired")
    m.ctx.timeoutTimer.observeField("fire", "onTimeoutFired")
end sub

sub show()
    loadingOps.show(m.ctx)
end sub

sub hide()
    loadingOps.hide(m.ctx)
end sub

sub showError(text = "" as string)
    loadingOps.showError(m.ctx, text)
end sub

sub onDelayFired()
    loadingOps.reveal(m.ctx)
end sub

sub onTimeoutFired()
    loadingOps.showError(m.ctx, m.top.errorMessage)
end sub

sub onErrorDialogDismissed()
    loadingOps.dismissError(m.ctx)
    m.top.errorDismissed = true
end sub
