import "pkg:/source/theme/theme.bs"
import "pkg:/source/widgets/loadingOps.bs"

sub init()
    m.ctx = loadingOps.newContext(m.top)

    m.ctx.spinner.poster.uri = "pkg:/images/spinner.png"
    m.ctx.spinner.poster.width = 96
    m.ctx.spinner.poster.height = 96

    m.ctx.delayTimer.observeField("fire", "onDelayFired")
    m.ctx.timeoutTimer.observeField("fire", "onTimeoutFired")

    applyTheme()
end sub

sub applyTheme()
    t = theme.current()

    m.ctx.statusLabel.color = t.color("component.page.statusTextColor", "0xB7BDC5FF")
    m.ctx.statusLabel.font = t.font("component.page.statusTextTypography", "font:MediumSystemFont")
end sub

sub show()
    loadingOps.show(m.ctx)
end sub

sub hide()
    loadingOps.hide(m.ctx)
end sub

sub showError(text = "" as string)
    loadingOps.showError(m.ctx, text)
end sub

sub onDelayFired()
    loadingOps.reveal(m.ctx)
end sub

sub onTimeoutFired()
    loadingOps.showError(m.ctx, m.top.errorMessage)
end sub

