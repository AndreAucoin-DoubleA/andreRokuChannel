import "pkg:/source/theme/theme.bs"
import "pkg:/source/widgets/rowListOps.bs"

sub init()
    m.ctx = rowListOps.newContext(m.top)

    m.ctx.rowList.observeField("rowItemFocused", "onRowItemFocused")
    m.ctx.rowList.observeField("rowItemSelected", "onRowItemSelected")

    applyTheme()
    onRowSpacingChanged()

    m.ctx.decor.rowList = m.ctx.rowList
end sub

sub applyTheme()
    t = theme.current()

    m.ctx.rowList.rowItemSize = [[t.size("component.moviePoster.width", 376), t.size("component.moviePoster.height", 220)]]
    m.ctx.rowList.rowLabelColor = t.color("component.rowList.rowLabelColor", "0x8E949DFF")
    m.ctx.rowList.rowLabelFont = t.font("component.rowList.rowLabelTypography", "font:SmallSystemFont")
end sub

sub onRowSpacingChanged()
    if m.ctx = invalid then return

    rowListOps.applySpacing(m.ctx)
end sub

sub onContentChanged()
    if m.ctx = invalid then return

    rowListOps.applyContent(m.ctx)
end sub

function hasRows() as boolean
    return rowListOps.hasRows(m.ctx)
end function

sub onRowItemFocused()
    rowListOps.rowItemFocused(m.ctx)
end sub

sub onRowItemSelected()
    rowListOps.rowItemSelected(m.ctx)
end sub

function focusRows() as boolean
    return rowListOps.focusRows(m.ctx)
end function

