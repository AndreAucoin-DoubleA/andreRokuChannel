import "pkg:/source/theme/theme.bs"
import "pkg:/source/widgets/navItemOps.bs"

sub init()
    m.ctx = navItemOps.newContext(m.top)

    applyTheme()

    m.global.observeField("navCollapsed", "onCollapsedChanged")

    navItemOps.applyInitial(m.ctx, isCollapsed())
end sub

function isCollapsed() as boolean
    return m.global.navCollapsed = true
end function

sub applyTheme()
    t = theme.current()

    m.ctx.labelColor = t.color("component.navItem.labelColor", "0x8E949DFF")
    m.ctx.labelColorFocused = t.color("component.navItem.labelColorFocused", "0xFFFFFFFF")

    m.ctx.widthExpanded = t.size("component.navItem.width", 250)
    m.ctx.widthCollapsed = t.size("component.navItem.widthCollapsed", 80)

    itemHeight = t.size("component.navItem.height", 70)

    m.ctx.highlight.blendColor = t.color("component.navItem.highlightColor", "0x6C3FA0FF")
    m.ctx.highlight.height = itemHeight

    m.ctx.label.height = itemHeight
    m.ctx.label.color = m.ctx.labelColor
    m.ctx.label.font = t.font("component.navItem.labelTypography", "font:MediumSystemFont")
end sub

sub onContentChanged()
    if m.ctx = invalid then return

    navItemOps.applyContent(m.ctx)
end sub

sub updateHighlight()
    if m.ctx = invalid then return

    navItemOps.updateHighlight(m.ctx)
end sub

sub onCollapsedChanged()
    navItemOps.applyCollapsed(m.ctx, isCollapsed())
end sub

