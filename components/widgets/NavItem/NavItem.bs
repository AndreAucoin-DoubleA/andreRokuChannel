import "pkg:/source/theme/theme.bs"
import "pkg:/source/operations/navItemOps.bs"

sub init()
    m.ctx = navItemOps.newContext(m.top)

    applyTheme()

    navItemOps.applyInitial(m.ctx)
end sub

sub applyTheme()
    t = theme.current()

    m.ctx.inkResting = "0xC5C8CAFF"
    m.ctx.inkSelected = "0xE1E5E6FF"
    m.ctx.inkActive = t.color("color.key.primary", "0x101018FF")

    m.ctx.discSelected = "0xFFFFFF33"
    m.ctx.discActive = t.color("color.key.secondary", "0x007AFFFF")

    m.ctx.fontResting = navLabelFont(31)
    m.ctx.fontFocused = navLabelFont(38)

    m.ctx.label.height = t.size("component.navItem.height", 70)
end sub

function navLabelFont(size as integer) as object
    font = CreateObject("roSGNode", "Font")
    font.uri = theme.FontUri("Inter Regular")
    font.size = size
    return font
end function

sub onContentChanged()
    if m.ctx = invalid then return

    navItemOps.applyContent(m.ctx)
end sub

sub updateHighlight()
    if m.ctx = invalid then return

    navItemOps.updateHighlight(m.ctx)
end sub
