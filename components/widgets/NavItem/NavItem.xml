<?xml version="1.0" encoding="utf-8"?>
<component name="NavItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/NavItem/NavItem.bs"/>

    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged"/>
        <field id="focusPercent" type="float" onChange="updateHighlight"/>
        <field id="listHasFocus" type="boolean" onChange="updateHighlight"/>
    </interface>

    <children>
        <Poster
            id="iconBackdrop"
            uri="pkg:/assets/images/nav_icon_circle.png"
            translation="[0,3]"
            width="64"
            height="64"/>
        <Poster
            id="icon"
            translation="[9,12]"
            width="46"
            height="46"/>
        <Label
            id="label"
            translation="[72,2]"
            height="70"
            vertAlign="center"/>
    </children>
</component>
