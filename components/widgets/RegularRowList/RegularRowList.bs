import "pkg:/source/theme/theme.bs"
import "pkg:/source/operations/rowListOps.bs"

const CLIP_LEFT = -24
const CLIP_WIDTH = 1944
const CLIP_SLACK = 80

sub init()
    m.ctx = rowListOps.newContext(m.top)
    m.rowList = m.ctx.rowList

    m.focusRing = m.top.findNode("focusRing")
    m.cardBorder = m.top.findNode("cardBorder")

    t = theme.current()
    m.focusRing.blendColor = t.color("component.regularPoster.focusRingColor", "0xB7BDC5FF")
    m.cardBorder.blendColor = t.color("component.regularPoster.borderColor", "0x007AFFFF")
    m.rowList.rowLabelColor = t.color("component.rowList.rowLabelColor", "0x8E949DFF")
    m.rowList.rowLabelFont = t.font("component.rowList.rowLabelTypography", "font:SmallSystemFont")

    m.top.observeField("focusedChild", "onRowFocusChanged")
    m.rowList.observeField("focusedChild", "onRowFocusChanged")
    m.rowList.observeField("rowItemFocused", "onRowItemFocused")
    m.rowList.observeField("rowItemSelected", "onRowItemSelected")

    applyNumRows()
    onRowFocusChanged()
end sub

sub applyNumRows()
    if m.ctx = invalid then return

    rows = m.top.numRows
    if rows < 1 then rows = 1

    m.rowlist.numRows = rows

    rowHeight = m.rowList.itemSize[1]
    spacing = m.rowlIst.itemSpacing[1]
    clipHeight = (rows * rowHeight) + ((rows - 1) * spacing) + CLIP_SLACK

    m.top.clippingRect = [CLIP_LEFT, 0, CLIP_WIDTH, clipHeight]
end sub

sub onNumRowsChanged()
    applyNumRows()
end sub

sub onContentChanged()
    if m.ctx = invalid then return

    rowListOps.applyContent(m.ctx)
end sub

sub onRowFocusChanged()
    if m.focusRing = invalid then return

    lit = 0.0
    if m.rowList.isInFocusChain() then lit = 1.0

    m.focusRing.opacity = lit
    m.cardBorder.opacity = lit
end sub

sub onRowItemFocused()
    if m.ctx = invalid then return

    rowListOps.rowItemFocused(m.ctx)
end sub

sub onRowItemSelected()
    if m.ctx = invalid then return

    rowListOps.rowItemSelected(m.ctx)
end sub

function focusRows() as boolean
    return rowListOps.focusRows(m.ctx)
end function
