import "pkg:/source/theme/theme.bs"
import "pkg:/source/widgets/chromeOps.bs"

sub init()
    m.ctx = chromeOps.newContext(m.top)

    t = theme.current()
    m.ctx.ring.uri = "pkg:/images/item_focus_ring.png"
    m.ctx.ring.blendColor = t.color("component.moviePoster.focusRingColor", "0x8B5CD6FF")
    m.ctx.capColor = t.color("component.scene.backgroundColor", "0x202226FF")

    m.ctx.summaryTitle.color = t.color("component.rowList.summaryTitleColor", "0xFFFFFFFF")
    m.ctx.summaryTitle.font = t.font("component.rowList.summaryTitleTypography", "font:MediumBoldSystemFont")
    m.ctx.summaryTitle.ellipsizeOnBoundary = true
end sub

sub onRowListChanged()
    if m.ctx = invalid then return

    chromeOps.attach(m.ctx, m.top.rowList)
end sub

sub onGeometryChanged()
    if m.ctx = invalid then return

    chromeOps.applyGeometry(m.ctx)
end sub

sub onVertScroll()
    if m.ctx = invalid then return

    chromeOps.applyScroll(m.ctx)
end sub

sub onVisibilityChanged()
    if m.ctx = invalid then return

    chromeOps.applyVisibility(m.ctx)
end sub
