<?xml version="1.0" encoding="utf-8"?>
<component name="RowListChrome" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/RowListChrome/RowListChrome.bs"/>

    <interface>
        <field id="rowList" type="node" onChange="onRowListChanged"/>
        <field id="offsetY" type="float" value="8" onChange="onGeometryChanged"/>
        <field id="summaryGap" type="float" value="30" onChange="onGeometryChanged"/>
        <field id="summaryColumns" type="float" value="3" onChange="onGeometryChanged"/>
        <field id="summaryText" type="string" alias="summaryTitle.text"/>
    </interface>

    <children>
        <Group id="capLayer"/>
        <Poster id="ring" visible="false"/>
        <Label id="summaryTitle" text="" height="44" visible="false"/>
    </children>
</component>
