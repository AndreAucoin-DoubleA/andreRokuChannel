<?xml version="1.0" encoding="utf-8"?>
<component name="TextButton" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/TextButton/TextButton.bs"/>

    <interface>
        <field id="text" type="string" onChange="onTextChanged"/>
        <field id="audioGuideText" type="string"/>
        <field id="iconUri" type="string" value="" onChange="onIconChanged"/>
        <field id="iconUriFocused" type="string" value="" onChange="onIconChanged"/>
        <field id="iconTint" type="boolean" value="true" onChange="onFocusChanged"/>
        <field id="width" type="float" value="0" onChange="onWidthChanged"/>
        <field id="height" type="float" value="0" onChange="onHeightChanged"/>
        <field id="selected" type="boolean" alwaysNotify="true"/>
    </interface>

    <children>
        <Poster
            id="customButton"
            uri="pkg:/assets/images/cta_pill.9.png"
            width="280"
            height="70">
            <Poster
                id="icon"
                width="48"
                height="48"
                visible="false"/>

            <Label
                id="label"
                width="280"
                height="70"
                horizAlign="center"
                vertAlign="center"/>
        </Poster>
    </children>
</component>
