<?xml version="1.0" encoding="utf-8"?>
<component name="TextButton" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/widgets/TextButton/TextButton.bs"/>

    <interface>
        <field id="text" type="string" onChange="onTextChanged"/>
        <field id="audioGuideText" type="string"/>
        <field id="width" type="float" value="280" onChange="onWidthChanged"/>
        <field id="selected" type="boolean" alwaysNotify="true"/>
    </interface>

    <children>
        <Rectangle id="customButton" width="280" height="70" color="#2A2D32">
            <Label
                id="label"
                translation="[0,20]"
                width="280"
                horizAlign="center"
                font="font:MediumBoldSystemFont"
                color="#B7BDC5"/>
        </Rectangle>
    </children>
</component>
