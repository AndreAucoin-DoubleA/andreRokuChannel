import "pkg:/source/generated/localConfig.bs"

namespace multiview

    const FALLBACK_HOST = "http://127.0.0.1:8000"

    function host() as string
        return normalizeHost(localConfig.multiviewHost())
    end function

    function normalizeHost(configured as string) as string
        result = configured

        while Len(result) > 0 and Right(result, 1) = "/"
            result = Left(result, Len(result) - 1)
        end while

        if result = "" then return FALLBACK_HOST

        return result
    end function

    function mosaicUrl() as string
        return `${host()}/hls/master.m3u8`
    end function

    function titleLabels() as string[]
        return [
            "CAM 1 / PIT LANE"
            "CAM 2 / TURN 3"
            "CAM 3 / ONBOARD"
            "CAM 4 / GRANDSTAND"
        ]
    end function

end namespace
