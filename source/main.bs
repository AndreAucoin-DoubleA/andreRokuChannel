import "pkg:/source/utils/logger.bs"

sub Main(args as object)
    screen = CreateObject("roSGScreen")
    m.port = CreateObject("roMessagePort")
    screen.setMessagePort(m.port)

    m.input = CreateObject("roInput")
    m.input.SetMessagePort(m.port)

    deviceInfo = CreateObject("roDeviceInfo")
    deviceInfo.SetMessagePort(m.port)
    deviceInfo.EnableLowGeneralMemoryEvent(true)
    deviceInfo.EnableAudioGuideChangedEvent(true)

    m.appMemoryMonitor = CreateObject("roAppMemoryMonitor")
    m.appMemoryMonitor.SetMessagePort(m.port)
    m.appMemoryMonitor.EnableMemoryWarningEvent(true)

    channelMemoryLimit = m.appMemoryMonitor.GetChannelMemoryLimit()
    logger.info("main", `memory limit KB - foreground: ${channelMemoryLimit.maxForegroundMemory} background: ${channelMemoryLimit.maxBackgroundMemory} Roku-managed heap: ${channelMemoryLimit.maxRokuManagedHeapMemory}`)
    logger.info("main", `available memory KB: ${m.appMemoryMonitor.GetChannelAvailableMemory()}`)

    globals = screen.getGlobalNode()

    globals.addFields({
        navCollapsed: true,
        screenReaderOn: deviceInfo.IsAudioGuideEnabled(),
        designTokens: tokens.loadTokens("pkg:/tokens/tokens.json"),
        catalog: CreateObject("roSGNode", "ContentNode"),
        catalogVersion: 0,
        catalogReady: false,
        favoritesVersion: 0
    })

    m.scene = screen.CreateScene("MainScene")
    screen.show()

    if deeplink.hasLink(args)
        m.scene.deepLink = deeplink.parse(args)
    end if

    while true
        msg = wait(0, m.port)
        if type(msg) = "roSGScreenEvent"
            if msg.isScreenClosed() then return
        else if type(msg) = "roDeviceInfoEvent"
            info = msg.getInfo()

            if info.audioGuideEnabled <> invalid
                globals.setField("screenReaderOn", info.audioGuideEnabled)

                logger.info("a11y", `screen reader enabled: ${info.audioGuideEnabled}`)
            end if

            if info.generalMemoryLevel <> invalid and info.generalMemoryLevel <> "normal"
                'Free caches, release unused ContentNodes, etc.
            end if
        else if type(msg) = "roAppMemoryNotificationEvent"
            'App memory usage crossed a warning threshold (80/85/90/95%); free caches, release unused ContentNodes, etc.
            logger.warn("main", `app memory usage: ${m.appMemoryMonitor.GetMemoryLimitPercent()}%`)
        else if type(msg) = "roInputEvent"
            if msg.IsInput()
                info = msg.getInfo()
                logger.debug("main", `roInput: ${FormatJson(info)}`)
                if deeplink.hasLink(info) then m.scene.deepLink = deeplink.parse(info)
            end if
        end if
    end while
end sub
