import "pkg:/source/utils/logger.bs"
import "pkg:/source/navigation/routes.interface.bs"
import "pkg:/source/navigation/nav.interface.bs"

namespace routes

    enum RouteId
        home = "home"
        movies = "movies"
        games = "games"
        multiview = "multiview"
    end enum

    function all() as routes.Route[]
        return [
            { id: RouteId.home, label: "Home", icon: "pkg:/images/home_icon.png", component: nav.ViewId.home }
            { id: RouteId.movies, label: "Movies", icon: "pkg:/images/settings_icon.png", component: nav.ViewId.movies }
            { id: RouteId.games, label: "Games", icon: "pkg:/images/menu_icon.png", component: nav.ViewId.games }
            { id: RouteId.multiview, label: "Multiview", icon: "pkg:/images/menu_icon.png", component: nav.ViewId.multiview }
        ]
    end function

    function byId(id as string) as routes.Route
        for each route in all()
            if route.id = id then return route
        end for

        logger.warn("routes", `no route with id ${id}`)

        return invalid
    end function

    function indexOf(id as string) as integer
        routeList = all()

        for index = 0 to routeList.Count() - 1
            if routeList[index].id = id then return index
        end for

        return -1
    end function

end namespace
