import "pkg:/source/services/a11y.bs"
import "pkg:/source/services/dialogs.bs"

namespace loadingOps

    function newContext(top as object) as object
        return {
            top: top,
            content: top.findNode("content"),
            spinner: top.findNode("spinner"),
            delayTimer: top.findNode("delayTimer"),
            timeoutTimer: top.findNode("timeoutTimer"),
            active: false,
            errorDialog: invalid
        }
    end function

    sub show(ctx as object)
        if ctx.active then return
        ctx.active = true

        ctx.spinner.visible = true

        ctx.delayTimer.duration = ctx.top.showDelay
        ctx.delayTimer.control = "start"

        if ctx.top.timeout > 0
            ctx.timeoutTimer.duration = ctx.top.timeout
            ctx.timeoutTimer.control = "start"
        end if
    end sub

    sub reveal(ctx as object)
        ctx.content.visible = true
        ctx.spinner.control = "start"

        a11y.context(ctx.top.message)
    end sub

    sub hide(ctx as object)
        ctx.active = false

        ctx.delayTimer.control = "stop"
        ctx.timeoutTimer.control = "stop"
        ctx.spinner.control = "stop"
        ctx.content.visible = false
    end sub

    sub showError(ctx as object, text = "" as string)
        loadingOps.hide(ctx)

        message = text
        if message = "" then message = ctx.top.errorMessage

        ctx.errorDialog = dialogs.show(ctx.top, ctx.top.errorTitle, message, "onErrorDialogDismissed")

        a11y.context(message)
    end sub

    sub dismissError(ctx as object)
        dialogs.close(ctx.errorDialog)
        ctx.errorDialog = invalid
    end sub

end namespace
