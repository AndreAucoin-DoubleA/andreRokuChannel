namespace navItemOps
    function newContext(top as object) as object
        return {
            top: top,
            icon: top.findNode("icon"),
            label: top.findNode("label"),
            highlight: top.findNode("highlight"),
            labelColor: "0x8E949DFF",
            labelColorFocused: "0xFFFFFFFF",
            widthExpanded: 250.0
        }
    end function

    sub applyContent(ctx as object)
        content = ctx.top.itemContent

        ctx.label.text = content.title
        ctx.icon.uri = content.hdPosterUrl
    end sub

    sub updateHighlight(ctx as object)
        p = ctx.top.focusPercent

        dimFactor = 1.0
        if not ctx.top.listHasFocus then dimFactor = 0.45
        ctx.highlight.opacity = p * dimFactor

        if p > 0.5
            ctx.label.color = ctx.labelColorFocused
        else
            ctx.label.color = ctx.labelColor
        end if
    end sub

    sub applyInitial(ctx as object)
        ctx.highlight.width = ctx.widthExpanded
    end sub

end namespace
