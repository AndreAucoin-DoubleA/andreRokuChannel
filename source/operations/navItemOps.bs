namespace navItemOps

    function newContext(top as object) as object
        return {
            top: top,
            icon: top.findNode("icon"),
            label: top.findNode("label"),
            backdrop: top.findNode("iconBackdrop"),
            iconResting: "",
            iconFilled: "",
            inkResting: "0xC5C8CAFF",
            inkSelected: "0xE1E5E6FF",
            inkActive: "0x101018FF",
            discSelected: "0xFFFFFF33",
            discActive: "0x007AFFFF",
            fontResting: invalid,
            fontFocused: invalid
        }
    end function

    sub applyContent(ctx as object)
        content = ctx.top.itemContent

        ctx.label.text = content.title
        ctx.iconResting = content.hdPosterUrl

        ctx.iconFilled = content.hdPosterUrl
        if content.hasField("iconFilled") and content.iconFilled <> ""
            ctx.iconFilled = content.iconFilled
        end if

        navItemOps.updateHighlight(ctx)
    end sub

    function stateFor(ctx as object) as object
        labelOpacity = 0.0
        if ctx.top.listHasFocus then labelOpacity = 1.0

        if ctx.top.focusPercent <= 0.5
            return {
                uri: ctx.iconResting,
                ink: ctx.inkResting,
                labelInk: ctx.inkResting,
                labelOpacity: labelOpacity,
                disc: invalid,
                font: ctx.fontResting
            }
        end if

        if ctx.top.listHasFocus
            return {
                uri: ctx.iconFilled,
                ink: ctx.inkActive,
                labelInk: ctx.inkSelected,
                labelOpacity: labelOpacity,
                disc: ctx.discActive,
                font: ctx.fontFocused
            }
        end if

        return {
            uri: ctx.iconFilled,
            ink: ctx.inkSelected,
            labelInk: ctx.inkSelected,
            labelOpacity: labelOpacity,
            disc: ctx.discSelected,
            font: ctx.fontFocused
        }
    end function

    sub updateHighlight(ctx as object)
        navItemOps.applyState(ctx, navItemOps.stateFor(ctx))
    end sub

    sub applyState(ctx as object, state as object)
        if state.uri <> "" and ctx.icon.uri <> state.uri then ctx.icon.uri = state.uri

        ctx.icon.blendColor = state.ink
        ctx.label.color = state.labelInk
        ctx.label.opacity = state.labelOpacity

        ctx.backdrop.visible = state.disc <> invalid
        if state.disc <> invalid then ctx.backdrop.blendColor = state.disc

        if state.font <> invalid then ctx.label.font = state.font
    end sub

    sub applyInitial(ctx as object)
        navItemOps.updateHighlight(ctx)
    end sub

end namespace
