import "pkg:/source/utils/logger.bs"

namespace analytics

    sub trackEvent(name as string, props = {} as object)
        task = m.global.analyticsTask

        if task = invalid
            logger.warn("analytics", `dropped event, task not ready: ${name}`)
            return
        end if

        task.event = {
            name: name,
            props: props,
            ts: CreateObject("roDateTime").ToISOString()
        }
    end sub

    sub SendEvent(event as object)
        if event = invalid or event.name = invalid then return

        logger.info("analytics", FormatJson(event))
    end sub

end namespace
