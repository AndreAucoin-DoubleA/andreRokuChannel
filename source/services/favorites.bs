import "pkg:/source/analytics.bs"

namespace favorites

    function section() as object
        return CreateObject("roRegistrySection", "favorites")
    end function

    function isFavorite(movieId as dynamic) as boolean
        if movieId = invalid or movieId = "" then return false

        return section().Exists(movieId)
    end function

    sub setFavorite(movieId as dynamic, favorited as boolean)
        if movieId = invalid or movieId = "" then return

        registry = section()

        if favorited
            registry.Write(movieId, CreateObject("roDateTime").AsSeconds().ToStr())
        else
            registry.Delete(movieId)
        end if

        registry.Flush()

        m.global.favoritesVersion = m.global.favoritesVersion + 1

        analytics.trackEvent("favorite_toggled", {
            movieId: movieId,
            favorited: favorited,
            totalFavorites: registry.GetKeyList().Count()
        })
    end sub

    function favoriteIds() as object
        registry = section()
        entries = []

        for each movieId in registry.GetKeyList()
            entries.Push({ movieId: movieId, addedAt: registry.Read(movieId).ToInt() })
        end for

        entries.SortBy("addedAt", "r")

        ids = []

        for each entry in entries
            ids.Push(entry.movieId)
        end for

        return ids
    end function

end namespace
