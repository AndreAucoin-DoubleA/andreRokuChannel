import "pkg:/source/utils/strings.bs"
import "pkg:/source/services/watchlist.interface.bs"

namespace watchlist

    const SECTION_NAME = "watchlist"
    const ORDER_KEY = "__order"

    function section() as object
        return CreateObject("roRegistrySection", SECTION_NAME)
    end function

    function ids() as string[]
        registry = section()
        if not registry.Exists(ORDER_KEY) then return []
        raw = registry.Read(ORDER_KEY)
        if raw = "" then return []

        out = []
        for each id in raw.Split(",")
            if id <> "" then out.Push(id)
        end for

        return out
    end function

    function contains(movieId as dynamic) as boolean
        if movieId = invalid or movieId = "" then return false

        return section().Exists(movieId)
    end function

    function entryFrom(movie as roSGNodeContentNode) as watchlist.Entry
        return {
            movieId: strings.fromValue(movie.movieId),
            title: strings.fromValue(movie.title),
            releaseDate: strings.fromValue(movie.releaseDate),
            rating: strings.fromValue(movie.rating),
            poster: strings.fromValue(movie.HDPosterUrl),
            backdrop: strings.fromValue(movie.HDBackgroundImageUrl)
        }
    end function

    sub add(movie as roSGNodeContentNode)
        if movie = invalid then return

        movieId = strings.fromValue(movie.movieId)
        if movieId = "" then return

        registry = section()
        registry.Write(movieId, FormatJson(entryFrom(movie)))

        order = [movieId]

        for each id in ids()
            if id <> movieId then order.Push(id)
        end for

        while order.Count() > MAX_ENTRIES
            registry.Delete(order.Pop())
        end while

        registry.Write(ORDER_KEY, order.Join(","))
        registry.Flush()
    end sub

    sub remove(movieId as dynamic)
        if movieId = invalid or movieId = "" then return

        registry = section()
        registry.Delete(movieId)

        order = []
        for each id in ids()
            if id <> movieId then order.Push(id)
        end for

        registry.Write(ORDER_KEY, order.Join(","))
        registry.Flush()
    end sub

    function toggle(movie as roSGNodeContentNode) as boolean
        if movie = invalid then return false

        movieId = strings.fromValue(movie.movieId)
        if movieId = "" then return false

        if contains(movieId)
            remove(movieId)
            return false
        end if

        add(movie)
        return true
    end function

    function nodeFor(movieId as string) as roSGNodeContentNode
        registry = section()
        if not registry.Exists(movieId) then return invalid

        entry = ParseJson(registry.Read(movieId))
        if entry = invalid then return invalid

        item = CreateObject("roSGNode", "ContentNode")
        item.AddFields({ movieId: entry.movieId })

        item.title = entry.title
        item.SetField("releaseDate", entry.releaseDate)
        item.SetField("rating", entry.rating)
        item.SetField("HDPosterUrl", entry.poster)
        item.SetField("HDBackgroundImageUrl", entry.backdrop)

        return item
    end function

    function rowNode() as roSGNodeContentNode
        saved = ids()
        if saved.Count() = 0 then return invalid

        row = CreateObject("roSGNode", "ContentNode")
        row.title = ROW_TITLE

        for each movieId in saved
            item = nodeFor(movieId)
            if item <> invalid then row.appendChild(item)
        end for

        if row.getChildCount() = 0 then return invalid

        return row
    end function

    function rowIndex(root as object) as integer
        if root = invalid then return -1
        if root.getChildCount() = 0 then return -1
        if root.getChild(0).title <> ROW_TITLE then return -1

        return 0
    end function

    sub syncRow(root as object)
        if root = invalid then return

        existing = rowIndex(root)
        row = rowNode()

        if row = invalid
            if existing = 0 then root.removeChildIndex(0)
            return
        end if

        if existing = 0
            root.replaceChild(row, 0)
        else
            root.insertChild(row, 0)
        end if
    end sub
end namespace
