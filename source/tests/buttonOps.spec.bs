namespace tests

    @suite("TextButton")
    class TextButtonTests extends rooibos.BaseTestSuite

        @describe("TextButton")

        @beforeEach
        protected override sub beforeEach()
            probe = CreateObject("roSGNode", "ContentNode")
            probe.addFields({ request: {} })

            if m.global.hasField("speechTask")
                m.global.speechTask = probe
            else
                m.global.addFields({ speechTask: probe })
            end if
        end sub

        function newButton() as object
            return CreateObject("roSGNode", "TextButton")
        end function

        function spokenText() as dynamic
            return m.global.speechTask.request.focus
        end function

        @it("a text change updates the label")
        @params("Play")
        @params("Resume from 12:34")
        @params("")
        sub _(text as string)
            button = m.newButton()

            button.text = text

            m.assertEqual(button.findNode("label").text, text, "the onChange handler should mirror text")
        end sub

        @it("width 0 auto-sizes to the text")
        sub _()
            button = m.newButton()

            m.assertEqual(Int(button.width), 0, "the width field defaults to 0")

            button.text = "Play"
            button.width = 0

            m.assertEqual(Int(button.findNode("customButton").width), 280, "falls back to the XML width")
            m.assertEqual(Int(button.findNode("label").width), 280)
        end sub

        @it("a set width overrides auto-sizing")
        @params(400)
        @params(120)
        @params(1000)
        sub _(width as integer)
            button = m.newButton()

            button.width = width

            m.assertEqual(Int(button.findNode("customButton").width), width, "the background must follow")
            m.assertEqual(Int(button.findNode("label").width), width, "the label must follow so centring works")
        end sub

        function colorValue(spec as dynamic) as dynamic
            probe = CreateObject("roSGNode", "Poster")
            probe.blendColor = spec

            return probe.blendColor
        end function

        function iconButton(text = "Play" as string) as object
            button = m.newButton()
            button.width = 255
            button.text = text
            button.iconUri = "pkg:/assets/images/play/Play@2x-1.png"

            return button
        end function

        @it("no icon leaves the label centred across the whole button")
        sub _()
            button = m.newButton()
            button.width = 255
            button.text = "Play"

            m.assertFalse(button.findNode("icon").visible, "the icon slot stays out of the way")
            m.assertEqual(Int(button.findNode("label").width), 255, "the label spans the button")
            m.assertEqual(button.findNode("label").horizAlign, "center")
        end sub

        @it("an icon and its label are centred together as a pair")
        @params("Play")
        @params("Resume")
        sub _(text as string)
            button = m.iconButton(text)
            icon = button.findNode("icon")
            label = button.findNode("label")

            m.assertTrue(icon.visible, "the icon shows once a uri is set")

            leftGap = icon.translation[0]
            rightGap = 255 - (label.translation[0] + label.width)

            m.assertEqual(Int(leftGap), Int(rightGap), `${text}: the icon and label must sit centred as one unit`)
            m.assertTrue(label.translation[0] > icon.translation[0], "the label follows the icon")
        end sub

        @it("the icon is centred vertically in the button")
        sub _()
            button = m.iconButton()
            icon = button.findNode("icon")
            height = button.findNode("customButton").height

            m.assertEqual(Int(icon.translation[1]), Int((height - icon.height) / 2))
        end sub

        @it("the icon tints dark on focus and light at rest")
        sub _()
            t = theme.current()
            button = m.iconButton()
            icon = button.findNode("icon")

            m.assertEqual(icon.blendColor, m.colorValue(t.color("component.button.iconColor", "0xFFFFFFFF")), "light while resting")

            button.setFocus(true)

            m.assertEqual(icon.blendColor, m.colorValue(t.color("component.button.iconColorFocused", "0x101018FF")), "dark against the focused pill")
        end sub

        @it("clearing the icon restores the full width label")
        sub _()
            button = m.iconButton()

            button.iconUri = ""

            m.assertFalse(button.findNode("icon").visible)
            m.assertEqual(Int(button.findNode("label").width), 255, "the label reclaims the button")
            m.assertEqual(button.findNode("label").horizAlign, "center")
        end sub

        @it("an explicit height overrides the themed height")
        sub _()
            button = m.newButton()

            button.height = 74

            m.assertEqual(Int(button.findNode("customButton").height), 74, "the pill takes the instance height")
            m.assertEqual(Int(button.findNode("label").height), 74, "and the label follows so vertAlign still centres")
        end sub

        @it("height 0 falls back to the themed height")
        sub _()
            t = theme.current()
            button = m.newButton()

            m.assertEqual(Int(button.findNode("customButton").height), Int(t.size("component.button.height", 70)), "untouched buttons keep the token height")
        end sub

        @it("the icon re-centres vertically when the height changes")
        sub _()
            button = m.iconButton()

            button.height = 74
            icon = button.findNode("icon")

            m.assertEqual(Int(icon.translation[1]), Int((74 - icon.height) / 2), "the icon tracks the taller pill")
        end sub

        @it("a focused icon variant swaps on focus and back")
        sub _()
            button = m.newButton()
            button.iconUri = "pkg:/assets/images/addUnfill/Add_unfill@2x-1.png"
            button.iconUriFocused = "pkg:/assets/images/addFill/Add_fill@2x-1.png"

            icon = button.findNode("icon")
            m.assertEqual(icon.uri, button.iconUri, "unfilled while resting")

            button.setFocus(true)
            m.assertEqual(icon.uri, button.iconUriFocused, "filled while focused")

            button.setFocus(false)
            m.assertEqual(icon.uri, button.iconUri, "back to unfilled on blur")
        end sub

        @it("an icon with no focused variant stays put")
        sub _()
            button = m.iconButton()
            icon = button.findNode("icon")
            resting = icon.uri

            button.setFocus(true)

            m.assertEqual(icon.uri, resting, "buttons like Play keep one glyph")
        end sub

        @it("the background is the stretchable pill asset")
        sub _()
            bg = m.newButton().findNode("customButton")

            m.assertSubType(bg, "Poster", "blendColor tinting needs a Poster, not a Rectangle")
            m.assertEqual(bg.uri, "pkg:/assets/images/cta_pill.9.png", "a nine-patch keeps the corners crisp at any width")
        end sub

        @it("focus tints the pill and brightens the label")
        sub _()
            t = theme.current()
            button = m.newButton()
            bg = button.findNode("customButton")
            label = button.findNode("label")

            m.assertEqual(bg.blendColor, m.colorValue(t.color("component.button.bgColor", "0x2A2D32FF")), "precondition: resting tint")

            button.setFocus(true)

            m.assertEqual(bg.blendColor, m.colorValue(t.color("component.button.bgColorFocused", "0x007AFFFF")), "the pill tints on focus")
            m.assertEqual(label.color, m.colorValue(t.color("component.button.labelColorFocused", "0xFFFFFFFF")), "and the label brightens")
        end sub

        @it("losing focus restores the resting tint")
        sub _()
            t = theme.current()
            button = m.newButton()
            bg = button.findNode("customButton")

            button.setFocus(true)
            m.assertNotEqual(bg.blendColor, m.colorValue(t.color("component.button.bgColor", "0x2A2D32FF")), "precondition: focused")

            button.setFocus(false)

            m.assertEqual(bg.blendColor, m.colorValue(t.color("component.button.bgColor", "0x2A2D32FF")), "the resting tint returns")
            m.assertEqual(button.findNode("label").color, m.colorValue(t.color("component.button.labelColor", "0xB7BDC5FF")))
        end sub

        @it("gaining focus announces the label")
        sub _()
            button = m.newButton()
            button.text = "Play"

            m.assertInvalid(m.spokenText(), "precondition: nothing announced yet")

            buttonOps.announce(button)

            m.assertEqual(m.spokenText(), "Play, button", "the role must be appended")
        end sub

        @it("audioGuideText is announced in preference to text")
        sub _()
            button = m.newButton()
            button.text = "Play"
            button.audioGuideText = "Resume Dune from 12 minutes"

            buttonOps.announce(button)

            m.assertEqual(m.spokenText(), "Resume Dune from 12 minutes, button")

            silent = m.newButton()
            buttonOps.announce(silent)

            m.assertEqual(m.spokenText(), "Resume Dune from 12 minutes, button", "an unlabelled button must not announce")
        end sub

        @it("OK sets selected")
        sub _()
            button = m.newButton()

            m.assertFalse(button.selected, "precondition: not selected")

            m.assertTrue(buttonOps.handleKey(button, "OK", true), "OK must be consumed")
            m.assertTrue(button.selected)
        end sub

        @it("back is not handled")
        @params("back", true)
        @params("up", true)
        @params("ok", true)
        @params("OK", false)
        sub _(key as string, press as boolean)
            button = m.newButton()

            m.assertFalse(buttonOps.handleKey(button, key, press), `${key} press=${press} must not be handled`)
            m.assertFalse(button.selected, "selected must stay false")
        end sub

    end class
end namespace
