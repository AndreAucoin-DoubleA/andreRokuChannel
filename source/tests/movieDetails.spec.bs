namespace tests

    @suite("MovieDetailsView")
    class MovieDetailsViewTests extends rooibos.BaseTestSuite

        @describe("a11y")

        @setup
        protected override sub setup()
            m.savedBookmarks = {}
            registry = bookmarks.section()
            for each key in registry.GetKeyList()
                m.savedBookmarks[key] = registry.Read(key)
            end for
        end sub

        @teardown
        protected override sub tearDown()
            m.restore(bookmarks.section(), m.savedBookmarks)
        end sub

        sub restore(registry as object, saved as object)
            for each key in registry.GetKeyList()
                registry.Delete(key)
            end for
            for each key in saved
                registry.Write(key, saved[key])
            end for
            registry.Flush()
        end sub

        @beforeEach
        protected override sub beforeEach()
            m.clear(bookmarks.section())

            if not m.global.hasField("screenReaderOn")
                m.global.addFields({ screenReaderOn: false })
            end if
            m.global.screenReaderOn = false

            if not m.global.hasField("contentOffsetX")
                m.global.addFields({ contentOffsetX: 149.0 })
            end if
            m.global.contentOffsetX = 149.0

            probe = CreateObject("roSGNode", "ContentNode")
            probe.addFields({ request: {}, event: {} })

            if m.global.hasField("speechTask")
                m.global.speechTask = probe
            else
                m.global.addFields({ speechTask: probe })
            end if

            if m.global.hasField("analyticsTask")
                m.global.analyticsTask = probe
            else
                m.global.addFields({ analyticsTask: probe })
            end if
        end sub

        @afterEach
        protected override sub afterEach()
            m.clear(bookmarks.section())
        end sub

        sub clear(registry as object)
            for each key in registry.GetKeyList()
                registry.Delete(key)
            end for
            registry.Flush()
        end sub

        function newView() as object
            return CreateObject("roSGNode", "MovieDetailsView")
        end function

        function newMovie(movieId = "438631" as string) as object
            movie = CreateObject("roSGNode", "ContentNode")
            movie.addFields({
                movieId: movieId,
                certification: "PG-13",
                runtimeMinutes: 155,
                cast: "Timothee Chalamet, Rebecca Ferguson, Zendaya"
            })
            movie.title = "Dune"
            movie.description = "Paul Atreides leads nomadic tribes."
            movie.rating = "8.5"
            movie.releaseDate = "2021-10-22"
            movie.HDBackgroundImageUrl = "https://image.tmdb.org/t/p/w1280/b.jpg"

            return movie
        end function

        function announced() as dynamic
            return m.global.speechTask.request.context
        end function

        @it("announceScreen sends context before item focus")
        sub _()
            view = m.newView()

            m.assertInvalid(m.announced(), "precondition: nothing announced")

            view.callFunc("announceScreen")
            m.assertEqual(m.announced(), "Movie Details", "the screen name alone")

            view.callFunc("applyMovie", m.newMovie())
            view.callFunc("announceScreen")

            m.assertEqual(m.announced(), "Movie Details. Dune. 2021, rated PG-13, 2h 35m", "screen name, title, then metadata")
        end sub

        @describe("content & playback")

        function ids(chain as object) as string
            out = []
            for each control in chain
                out.Push(control.id)
            end for

            return out.Join(",")
        end function

        function focusedView(startId as string) as object
            view = m.newView()
            view.findNode(startId).setFocus(true)

            return view
        end function

        @it("focusChain lists the row left to right")
        sub _()
            view = m.newView()

            m.assertEqual(m.ids(view.callFunc("focusChain")), "playButton,watchlistButton", "play leads the row")

            view.findNode("watchlistButton").visible = false
            m.assertEqual(m.ids(view.callFunc("focusChain")), "playButton", "a hidden button leaves the focus order")
        end sub

        @it("moveFocus right advances along the row")
        sub _()
            view = m.focusedView("playButton")

            m.assertTrue(view.callFunc("moveFocus", 1), "the move is handled")
            m.assertTrue(view.findNode("watchlistButton").hasFocus())
        end sub

        @it("moveFocus left retreats along the row")
        sub _()
            view = m.focusedView("watchlistButton")

            m.assertTrue(view.callFunc("moveFocus", -1))
            m.assertTrue(view.findNode("playButton").hasFocus())
        end sub

        @it("moveFocus stops at the ends rather than wrapping")
        @params("playButton", -1)
        @params("watchlistButton", 1)
        sub _(startId as string, delta as integer)
            view = m.focusedView(startId)

            m.assertFalse(view.callFunc("moveFocus", delta), `${delta} from ${startId} must be unhandled`)
            m.assertTrue(view.findNode(startId).hasFocus(), "and focus must not move")
        end sub

        @it("the watchlist button carries the add icon untinted")
        sub _()
            button = m.newView().findNode("watchlistButton")
            icon = button.findNode("icon")

            m.assertEqual(button.iconUri, "pkg:/assets/images/addUnfill/Add_unfill@2x-1.png")
            m.assertTrue(icon.visible, "the icon shows inside the button")
            m.assertFalse(button.iconTint, "a two-colour glyph must not be tinted")
        end sub

        @it("the watchlist icon fills when the button takes focus")
        sub _()
            view = m.newView()
            button = view.findNode("watchlistButton")
            icon = button.findNode("icon")

            m.assertEqual(icon.uri, "pkg:/assets/images/addUnfill/Add_unfill@2x-1.png", "unfilled at rest")

            button.setFocus(true)

            m.assertEqual(icon.uri, "pkg:/assets/images/addFill/Add_fill@2x-1.png", "filled on focus")
        end sub

        @it("no row button clips its own content")
        @params("playButton")
        @params("watchlistButton")
        sub _(id as string)
            button = m.newView().findNode(id)
            icon = button.findNode("icon")

            m.assertTrue(icon.translation[0] >= 0, `${id}: the icon must start inside the pill`)
        end sub

        @it("both row buttons are real TextButtons")
        @params("playButton")
        @params("watchlistButton")
        sub _(id as string)
            button = m.newView().findNode(id)

            m.assertSubType(button, "TextButton", "a bare Group would not focus or fire")
            m.assertTrue(button.hasField("selected"), "the view observes this field")
        end sub

        @it("the play button is the focusable TextButton, not a bare Group")
        sub _()
            view = m.newView()
            button = view.findNode("playButton")

            m.assertSubType(button, "TextButton", "a duplicate id would shadow the real button")
            m.assertTrue(button.hasField("selected"), "onButtonPressed observes this field")
            view.callFunc("setViewFocus")
            m.assertTrue(button.hasFocus(), "setViewFocus must land on the real button")
        end sub

        @it("applyMovie populates title, description and metadata")
        sub _()
            view = m.newView()

            view.callFunc("applyMovie", m.newMovie())

            m.assertEqual(view.findNode("title").text, "Dune", "the title stands on its own")
            m.assertEqual(view.findNode("metaYear").text, "2021")
            m.assertEqual(view.findNode("ratingText").text, "PG-13", "the certification sits in the pill")
            m.assertTrue(view.findNode("ratingPill").visible, "and the pill is shown")
            m.assertEqual(view.findNode("metaRuntime").text, "2h 35m")
            m.assertEqual(view.findNode("desc").text, "Paul Atreides leads nomadic tribes.")
            m.assertEqual(view.findNode("cast").text, "Starring: Timothee Chalamet, Rebecca Ferguson, Zendaya")
            m.assertEqual(view.findNode("detailsBack").uri, "https://image.tmdb.org/t/p/w1280/b.jpg", "the backdrop follows")

            view.callFunc("applyMovie", invalid)
            m.assertEqual(view.findNode("title").text, "Dune", "left untouched")
            m.assertEqual(view.findNode("metaYear").text, "2021", "left untouched")
        end sub

        @it("an unrated movie falls back to N/A")
        sub _()
            view = m.newView()
            movie = m.newMovie()
            movie.certification = ""

            view.callFunc("applyMovie", movie)

            m.assertEqual(view.findNode("ratingText").text, "N/A", "the pill still reads")
            m.assertTrue(view.findNode("ratingPill").visible, "and stays on screen")
        end sub

        @it("the pill never shrinks below its minimum width")
        sub _()
            view = m.newView()
            movie = m.newMovie()
            movie.certification = "R"

            view.callFunc("applyMovie", movie)

            m.assertTrue(view.findNode("ratingPillBg").width >= 43, "a short rating keeps the design width")
        end sub

        @it("a longer rating widens the pill to fit")
        sub _()
            view = m.newView()
            movie = m.newMovie()
            movie.certification = "NC-17"

            view.callFunc("applyMovie", movie)
            wide = view.findNode("ratingPillBg").width

            movie.certification = "R"
            view.callFunc("applyMovie", movie)
            narrow = view.findNode("ratingPillBg").width

            m.assertTrue(wide > narrow, "the pill grows past its minimum rather than clipping")
            m.assertEqual(Int(narrow), 43, "and a short rating falls back to the design width")
        end sub

        @it("an unrated movie is announced as not rated")
        sub _()
            view = m.newView()
            movie = m.newMovie()
            movie.certification = ""

            view.callFunc("applyMovie", movie)
            view.callFunc("announceScreen")

            m.assertEqual(m.announced(), "Movie Details. Dune. 2021, not rated, 2h 35m", "N/A is not read aloud")
        end sub

    end class
end namespace
