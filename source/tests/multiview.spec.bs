namespace tests

    @suite("multiview")
    class MultiviewTests extends rooibos.BaseTestSuite

        @describe("multiview")

        @it("mosaicUrl() is the host plus /hls/master.m3u8")
        sub _()
            url = multiview.mosaicUrl()
            host = multiview.host()

            m.assertEqual(url, host + "/hls/master.m3u8")

            m.assertEqual(Left(url, Len(host)), host, "url must start with host()")
            m.assertEqual(Right(url, 16), "/hls/master.m3u8", "url must end with the playlist path")
            m.assertEqual(Instr(1, url, "//hls"), 0, "host and path joined with a double slash")
        end sub

        @it("titleLabels() returns four camera labels")
        sub _()
            labels = multiview.titleLabels()
            expected = [
                "CAM 1 / PIT LANE"
                "CAM 2 / TURN 3"
                "CAM 3 / ONBOARD"
                "CAM 4 / GRANDSTAND"
            ]

            m.assertArrayCount(labels, 4)

            seen = {}
            for index = 0 to expected.Count() - 1
                label = labels[index]

                m.assertEqual(label, expected[index], `label ${index} is wrong or out of order`)

                prefix = `CAM ${index + 1} /`
                m.assertEqual(Left(label, Len(prefix)), prefix, `label ${index} should start with "${prefix}"`)

                m.assertFalse(seen.DoesExist(label), `duplicate label: ${label}`)
                seen[label] = true
            end for
        end sub

        @it("host() is a well-formed origin with an explicit port and no trailing slash")
        sub _()
            host = multiview.host()

            m.assertNotEmpty(host, "host() is empty -- did scripts/genLocalConfig.js run?")
            m.assertEqual(Left(host, 7), "http://", "host() must be an http origin")
            m.assertNotEqual(Right(host, 1), "/", "host() must not end in a slash")
            m.assertTrue(Instr(8, host, ":") > 0, "host() must carry an explicit port")
        end sub

        @it("normalizeHost() strips trailing slashes and falls back when unset")
        @params("http://10.0.0.5:8000", "http://10.0.0.5:8000")
        @params("http://10.0.0.5:8000/", "http://10.0.0.5:8000")
        @params("http://10.0.0.5:8000///", "http://10.0.0.5:8000")
        @params("", "http://127.0.0.1:8000")
        @params("/", "http://127.0.0.1:8000")
        sub _(configured as string, expected as string)
            m.assertEqual(multiview.normalizeHost(configured), expected)
        end sub

    end class
end namespace

