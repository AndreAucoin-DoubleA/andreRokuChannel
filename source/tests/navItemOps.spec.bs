namespace tests

    @suite("NavItem")
    class NavItemTests extends rooibos.BaseTestSuite

        @describe("NavItem")

        function newCtx() as object
            return navItemOps.newContext(CreateObject("roSGNode", "NavItem"))
        end function

        function milli(value as dynamic) as integer
            return Int(value * 1000 + 0.5)
        end function

        function colorValue(hex as string) as dynamic
            probe = CreateObject("roSGNode", "Label")
            probe.color = hex

            return probe.color
        end function

        @it("updateHighlight applies both values")
        @params(0.0, 0, false)
        @params(0.25, 250, false)
        @params(0.5, 500, false)
        @params(0.75, 750, true)
        @params(1.0, 1000, true)
        sub _(focusPercent as float, expectedMilli as integer, focused as boolean)
            ctx = m.newCtx()
            ctx.top.listHasFocus = true

            ctx.top.focusPercent = focusPercent
            navItemOps.updateHighlight(ctx)

            m.assertEqual(m.milli(ctx.highlight.opacity), expectedMilli, "opacity tracks focusPercent")

            expectedColor = ctx.labelColor
            if focused then expectedColor = ctx.labelColorFocused

            m.assertEqual(ctx.label.color, m.colorValue(expectedColor), "the label colour switches past 0.5")
        end sub

        @it("listHasFocus false dims the highlight")
        @params(1.0, 450)
        @params(0.5, 225)
        @params(0.0, 0)
        sub _(focusPercent as float, expectedMilli as integer)
            ctx = m.newCtx()

            ctx.top.listHasFocus = false
            ctx.top.focusPercent = focusPercent
            navItemOps.updateHighlight(ctx)

            m.assertEqual(m.milli(ctx.highlight.opacity), expectedMilli, "dimmed to 45%")

            ctx.top.listHasFocus = true
            navItemOps.updateHighlight(ctx)

            m.assertEqual(m.milli(ctx.highlight.opacity), m.milli(focusPercent), "undimmed when the list has focus")
        end sub
    end class
end namespace
