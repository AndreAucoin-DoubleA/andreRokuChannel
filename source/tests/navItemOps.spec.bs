namespace tests

    @suite("NavItem")
    class NavItemTests extends rooibos.BaseTestSuite

        @describe("NavItem")

        function newCtx() as object
            return navItemOps.newContext(CreateObject("roSGNode", "NavItem"))
        end function

        @it("a resting item gets the outline icon, neutral ink and no disc")
        @params(0.0)
        @params(0.25)
        @params(0.5)
        sub _(focusPercent as float)
            ctx = m.newCtx()
            ctx.iconResting = "outline.png"
            ctx.iconFilled = "filled.png"

            ctx.top.listHasFocus = true
            ctx.top.focusPercent = focusPercent

            state = navItemOps.stateFor(ctx)

            m.assertEqual(state.uri, "outline.png", "resting items keep the outline glyph")
            m.assertEqual(state.ink, ctx.inkResting, "neutral80 ink")
            m.assertInvalid(state.disc, "no disc behind a resting item")
        end sub

        @it("the current item in a focused rail gets the secondary disc and primary glyph")
        sub _()
            ctx = m.newCtx()
            ctx.iconResting = "outline.png"
            ctx.iconFilled = "filled.png"

            ctx.top.listHasFocus = true
            ctx.top.focusPercent = 1.0

            state = navItemOps.stateFor(ctx)

            m.assertEqual(state.uri, "filled.png", "the filled glyph marks the current item")
            m.assertEqual(state.ink, ctx.inkActive, "key primary glyph on the blue disc")
            m.assertEqual(state.disc, ctx.discActive, "key secondary disc")
            m.assertEqual(state.labelInk, ctx.inkSelected, "the label stays light outside the disc")
        end sub

        @it("the current item keeps the filled glyph on a translucent disc once the rail loses focus")
        sub _()
            ctx = m.newCtx()
            ctx.iconResting = "outline.png"
            ctx.iconFilled = "filled.png"

            ctx.top.listHasFocus = false
            ctx.top.focusPercent = 1.0

            state = navItemOps.stateFor(ctx)

            m.assertEqual(state.uri, "filled.png", "still the current item")
            m.assertEqual(state.ink, ctx.inkSelected, "light ink, not the dark on-blue ink")
            m.assertEqual(state.disc, ctx.discSelected, "white at 20%")
        end sub

        @it("falls back to the outline glyph when a route ships no filled export")
        sub _()
            ctx = m.newCtx()

            content = CreateObject("roSGNode", "ContentNode")
            content.setFields({ title: "Movies", hdPosterUrl: "outline.png" })
            ctx.top.itemContent = content

            navItemOps.applyContent(ctx)

            m.assertEqual(ctx.iconFilled, "outline.png", "no filled export - reuse the outline")
        end sub
    end class
end namespace
