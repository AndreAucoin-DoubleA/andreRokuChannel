namespace tests

    @suite("routes")
    class RoutesTests extends rooibos.BaseTestSuite

        function viewIds() as object
            return [
                nav.ViewId.search,
                nav.ViewId.home,
                nav.ViewId.movies,
                nav.ViewId.tv,
                nav.ViewId.settings,
                nav.ViewId.games,
                nav.ViewId.movieDetails,
                nav.ViewId.multiview,
                nav.ViewId.mosaicPlayer
            ]
        end function

        @describe("routes")

        @it("all returns six routes")
        sub _()
            m.assertArrayCount(routes.all(), 6)
        end sub

        @it("every route has id, label, icon and component")
        sub _()
            for each route in routes.all()
                m.assertAAHasKeys(route, ["id", "label", "icon", "iconFilled", "component"])
                m.assertNotEmpty(route.id, "a route is missing its id")
                m.assertNotEmpty(route.label, `route ${route.id} is missing its label`)
                m.assertNotEmpty(route.icon, `route ${route.id} is missing its icon`)
                m.assertNotEmpty(route.iconFilled, `route ${route.id} is missing its filled icon`)
            end for
        end sub

        @it("route ids are unique")
        sub _()
            seen = {}

            for each route in routes.all()
                m.assertFalse(seen.DoesExist(route.id), `duplicate route id: ${route.id}`)
                seen[route.id] = true
            end for
        end sub

        @it("every component is a valid nav.ViewId")
        sub _()
            valid = m.viewIds()

            for each route in routes.all()
                m.assertArrayContains(valid, route.component, invalid, `route ${route.id} points at unknown view ${route.component}`)
            end for
        end sub

        @it("byId resolves each of the six ids")
        @params("search", "Search", "SearchView")
        @params("home", "Home", "HomeView")
        @params("movies", "Movies", "MoviesView")
        @params("tv", "TV", "TVView")
        @params("settings", "Settings", "SettingsView")
        @params("multiview", "Multiview", "MultiviewView")
        sub _(id as string, expectedLabel as string, expectedComponent as string)
            route = routes.byId(id)

            m.assertNotInvalid(route, `byId did not resolve ${id}`)
            m.assertEqual(route.id, id)
            m.assertEqual(route.label, expectedLabel)
            m.assertEqual(route.component, expectedComponent)
        end sub

        @it("byId with a unknown id return invalid")
        @params("")
        @params("games")
        @params("Home")
        sub _(id as string)
            m.assertInvalid(routes.byId(id))
        end sub

        @it("indexOf follows the rail order")
        @params("search", 0)
        @params("home", 1)
        @params("movies", 2)
        @params("tv", 3)
        @params("settings", 4)
        @params("multiview", 5)
        sub _(id as string, expectedIndex as integer)
            m.assertEqual(routes.indexOf(id), expectedIndex)
        end sub

        @it("indexOf with an unknown id is -1")
        @params("")
        @params("games")
        @params("Home")
        sub _(id as string)
            m.assertEqual(routes.indexOf(id), -1)
        end sub
    end class
end namespace
