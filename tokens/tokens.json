{
  "$description": "Design tokens v1 (DTCG). Generated by design - do not hand-edit.",

  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#6C3FA0" },
      "bright": { "$value": "#8B5CD6" }
    },
    "grey": {
      "950": { "$value": "#101114" },
      "850": { "$value": "#202226" },
      "800": { "$value": "#2A2D32" },
      "400": { "$value": "#8E949D" },
      "300": { "$value": "#B7BDC5" },
      "200": { "$value": "#DDE0E4" }
    },
    "surface": {
      "base": { "$value": "{color.grey.850}" },
      "raised": { "$value": "{color.grey.800}" },
      "focused": { "$value": "{color.brand.primary}" }
    },
    "text": {
      "primary": { "$value": "#FFFFFF" },
      "body": { "$value": "{color.grey.200}" },
      "secondary": { "$value": "{color.grey.300}" },
      "muted": { "$value": "{color.grey.400}" },
      "onRaised": { "$value": "{color.grey.300}" }
    }
  },

  "sized": {
    "$type": "dimension",
    "nav": {
      "itemWidth": { "$value": "250px" },
      "itemHeight": { "$value": "70px" },
      "itemWidthCollapsed": { "$value": "80px" },
      "railExpanded": { "$value": "420px" },
      "railCollapsed": { "$value": "140px" }
    },
    "button": {
      "width": { "$value": "280px" },
      "height": { "$value": "70px" }
    },
    "poster": {
      "landscapeWidth": { "$value": "376px" },
      "landscapeHeight": { "$value": "220px" },
      "landscapeImageWidth": { "$value": "356px" },
      "landscapeImageHeight": { "$value": "200px" }
    }
  },

  "fontFamily": {
    "$type": "fontFamily",
    "body": { "$value": "Inter Regular" },
    "bold": { "$value": "Inter Bold" }
  },

  "typography": {
    "$type": "typography",
    "navLabel": {
      "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "28px" }
    },
    "buttonLabel": {
      "$value": { "fontFamily": "{fontFamily.bold}", "fontSize": "30px" }
    },
    "pageTitle": {
      "$value": { "fontFamily": "{fontFamily.bold}", "fontSize": "45px" }
    },
    "heroTitle": {
      "$value": { "fontFamily": "{fontFamily.bold}", "fontSize": "45px" }
    },
    "body": {
      "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "33px" }
    },
    "status": {
      "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "33px" }
    }
  },

  "component": {
    "navItem": {
      "labelColor": { "$type": "color", "$value": "{color.text.muted}" },
      "labelColorFocused": {
        "$type": "color",
        "$value": "{color.text.primary}"
      },
      "labelTypography": {
        "$type": "typography",
        "$value": "{typography.navLabel}"
      },
      "highlightColor": { "$type": "color", "$value": "{color.brand.primary}" },
      "width": { "$type": "dimension", "$value": "{sized.nav.itemWidth}" },
      "widthCollapsed": {
        "$type": "dimension",
        "$value": "{sized.nav.itemWidthCollapsed}"
      },
      "height": { "$type": "dimension", "$value": "{sized.nav.itemHeight}" }
    },
    "button": {
      "bgColor": { "$type": "color", "$value": "{color.surface.raised}" },
      "bgColorFocused": {
        "$type": "color",
        "$value": "{color.surface.focused}"
      },
      "labelColor": { "$type": "color", "$value": "{color.text.onRaised}" },
      "labelColorFocused": {
        "$type": "color",
        "$value": "{color.text.primary}"
      },
      "labelTypography": {
        "$type": "typography",
        "$value": "{typography.buttonLabel}"
      },
      "width": { "$type": "dimension", "$value": "{sized.button.width}" },
      "height": { "$type": "dimension", "$value": "{sized.button.height}" }
    },
    "scene": {
      "$description": "Fade blend colors are multipliers, not palette colors: blend = 255 * target / sourcePixel. bottomFade source #4395EA -> #101114. navFade source #6440DB -> #5A3A9E.",
      "backgroundColor": { "$type": "color", "$value": "{color.surface.base}" },
      "bottomFadeBlendColor": { "$type": "color", "$value": "#3D1D16" },
      "navFadeBlendColor": { "$type": "color", "$value": "#E6E7B8" },
      "navFadeOpacityCollapsed": { "$type": "number", "$value": 0.0 },
      "navFadeOpacityExpanded": { "$type": "number", "$value": 0.88 },
      "navRailExpanded": {
        "$type": "dimension",
        "$value": "{sized.nav.railExpanded}"
      },
      "navRailCollapsed": {
        "$type": "dimension",
        "$value": "{sized.nav.railCollapsed}"
      }
    },

    "page": {
      "titleColor": { "$type": "color", "$value": "{color.text.primary}" },
      "titleTypography": {
        "$type": "typography",
        "$value": "{typography.pageTitle}"
      },
      "bodyColor": { "$type": "color", "$value": "{color.text.secondary}" },
      "bodyTypography": {
        "$type": "typography",
        "$value": "{typography.body}"
      },
      "statusTextColor": {
        "$type": "color",
        "$value": "{color.text.secondary}"
      },
      "statusTextTypography": {
        "$type": "typography",
        "$value": "{typography.status}"
      },
      "heroTitleColor": { "$type": "color", "$value": "{color.text.primary}" },
      "heroTitleTypography": {
        "$type": "typography",
        "$value": "{typography.heroTitle}"
      }
    },

    "moviesPage": {
      "$description": "rightFade source pixel #3AAEEF -> #101114 via multiply.",
      "rightFadeBlendColor": { "$type": "color", "$value": "#461915" }
    },

    "movieDetails": {
      "$description": "bottomFade source pixel #0F0F23 -> #0F0F0F via multiply (blue channel only).",
      "scrimColor": { "$type": "color", "$value": "{color.surface.base}" },
      "scrimOpacity": { "$type": "number", "$value": 0.96 },
      "bottomFadeBlendColor": { "$type": "color", "$value": "#FFFF6D" },
      "metaColor": { "$type": "color", "$value": "{color.text.secondary}" },
      "metaTypography": {
        "$type": "typography",
        "$value": "{typography.body}"
      },
      "descriptionColor": { "$type": "color", "$value": "{color.text.body}" },
      "descriptionTypography": {
        "$type": "typography",
        "$value": "{typography.body}"
      }
    },

    "moviePoster": {
      "width": {
        "$type": "dimension",
        "$value": "{sized.poster.landscapeWidth}"
      },
      "height": {
        "$type": "dimension",
        "$value": "{sized.poster.landscapeHeight}"
      },
      "imageWidth": {
        "$type": "dimension",
        "$value": "{sized.poster.landscapeImageWidth}"
      },
      "imageHeight": {
        "$type": "dimension",
        "$value": "{sized.poster.landscapeImageHeight}"
      },
      "focusRingColor": { "$type": "color", "$value": "{color.brand.bright}" }
    }
  }
}
