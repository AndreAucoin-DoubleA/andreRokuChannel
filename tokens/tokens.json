{
  "$description": "Design tokens v1 (DTCG). Generated by design - do not hand-edit.",

  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#6C3FA0" }
    },
    "surface": {
      "base":    { "$value": "#0F0F23" },
      "raised":  { "$value": "#1B1B3A" },
      "focused": { "$value": "#4444AA" }
    },
    "text": {
      "primary":   { "$value": "#FFFFFF" },
      "body":      { "$value": "#DDDDEE" },
      "secondary": { "$value": "#AAAACC" },
      "muted":     { "$value": "#888899" },
      "onRaised":  { "$value": "#AAAACC" }
    }
  },

  "sized": {
    "$type": "dimension",
    "nav": {
      "itemWidth":          { "$value": "250px" },
      "itemHeight":         { "$value": "70px" },
      "itemWidthCollapsed": { "$value": "80px" },
      "railExpanded":       { "$value": "420px" },
      "railCollapsed":      { "$value": "140px" }
    },
    "button": {
      "width":  { "$value": "280px" },
      "height": { "$value": "70px" }
    },
    "poster": {
      "landscapeWidth":       { "$value": "376px" },
      "landscapeHeight":      { "$value": "220px" },
      "landscapeImageWidth":  { "$value": "356px" },
      "landscapeImageHeight": { "$value": "200px" }
    }
  },

  "fontFamily": {
    "$type": "fontFamily",
    "body": { "$value": "Inter Regular" },
    "bold": { "$value": "Inter Bold" }
  },

  "typography": {
    "$type": "typography",
    "navLabel":    { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "28px" } },
    "buttonLabel": { "$value": { "fontFamily": "{fontFamily.bold}", "fontSize": "30px" } },
    "pageTitle":   { "$value": { "fontFamily": "{fontFamily.bold}", "fontSize": "45px" } },
    "heroTitle":   { "$value": { "fontFamily": "{fontFamily.bold}", "fontSize": "45px" } },
    "body":        { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "33px" } },
    "status":      { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": "33px" } }
  },

  "component": {
    "navItem": {
      "labelColor":        { "$type": "color",      "$value": "{color.text.muted}" },
      "labelColorFocused": { "$type": "color",      "$value": "{color.text.primary}" },
      "labelTypography":   { "$type": "typography", "$value": "{typography.navLabel}" },
      "highlightColor":    { "$type": "color",      "$value": "{color.brand.primary}" },
      "width":             { "$type": "dimension",  "$value": "{sized.nav.itemWidth}" },
      "widthCollapsed":    { "$type": "dimension",  "$value": "{sized.nav.itemWidthCollapsed}" },
      "height":            { "$type": "dimension",  "$value": "{sized.nav.itemHeight}" }
    },
    "button": {
      "bgColor":           { "$type": "color",      "$value": "{color.surface.raised}" },
      "bgColorFocused":    { "$type": "color",      "$value": "{color.surface.focused}" },
      "labelColor":        { "$type": "color",      "$value": "{color.text.onRaised}" },
      "labelColorFocused": { "$type": "color",      "$value": "{color.text.primary}" },
      "labelTypography":   { "$type": "typography", "$value": "{typography.buttonLabel}" },
      "width":             { "$type": "dimension",  "$value": "{sized.button.width}" },
      "height":            { "$type": "dimension",  "$value": "{sized.button.height}" }
    },
    "scene": {
      "backgroundColor":  { "$type": "color",     "$value": "{color.surface.base}" },
      "navRailExpanded":  { "$type": "dimension", "$value": "{sized.nav.railExpanded}" },
      "navRailCollapsed": { "$type": "dimension", "$value": "{sized.nav.railCollapsed}" }
    },

    "page": {
      "titleColor":            { "$type": "color",      "$value": "{color.text.primary}" },
      "titleTypography":       { "$type": "typography", "$value": "{typography.pageTitle}" },
      "bodyColor":             { "$type": "color",      "$value": "{color.text.secondary}" },
      "bodyTypography":        { "$type": "typography", "$value": "{typography.body}" },
      "statusTextColor":       { "$type": "color",      "$value": "{color.text.secondary}" },
      "statusTextTypography":  { "$type": "typography", "$value": "{typography.status}" },
      "heroTitleColor":        { "$type": "color",      "$value": "{color.text.primary}" },
      "heroTitleTypography":   { "$type": "typography", "$value": "{typography.heroTitle}" }
    },

    "movieDetails": {
      "scrimColor":             { "$type": "color",      "$value": "{color.surface.base}" },
      "scrimOpacity":           { "$type": "number",     "$value": 0.96 },
      "metaColor":              { "$type": "color",      "$value": "{color.text.secondary}" },
      "metaTypography":         { "$type": "typography", "$value": "{typography.body}" },
      "descriptionColor":       { "$type": "color",      "$value": "{color.text.body}" },
      "descriptionTypography":  { "$type": "typography", "$value": "{typography.body}" }
    },

    "moviePoster": {
      "width":       { "$type": "dimension", "$value": "{sized.poster.landscapeWidth}" },
      "height":      { "$type": "dimension", "$value": "{sized.poster.landscapeHeight}" },
      "imageWidth":  { "$type": "dimension", "$value": "{sized.poster.landscapeImageWidth}" },
      "imageHeight": { "$type": "dimension", "$value": "{sized.poster.landscapeImageHeight}" }
    }
  }
}
